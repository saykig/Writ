{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/analysis/external-simulation-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "profile",
    "evidence_kind",
    "claim",
    "package",
    "model",
    "upstream_example_sha256",
    "inputs",
    "output",
    "assumptions",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "artifact_kind": {
      "const": "external_simulation_run"
    },
    "profile": {
      "const": "simpy-resource-fifo.v1"
    },
    "evidence_kind": {
      "const": "model_generated"
    },
    "claim": {
      "const": "finite_trace_under_supplied_inputs"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sdist_sha256",
        "source_manifest"
      ],
      "properties": {
        "name": {
          "const": "simpy"
        },
        "version": {
          "const": "4.1.1"
        },
        "sdist_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_manifest": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "content",
        "sha256"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "upstream_example_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "content",
        "sha256"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "content",
        "sha256"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "randomness",
        "time_arithmetic"
      ],
      "properties": {
        "implementation": {
          "const": "CPython"
        },
        "version": {
          "const": "3.13.15"
        },
        "randomness": {
          "const": "none"
        },
        "time_arithmetic": {
          "const": "integer"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrivals",
        "service_minutes",
        "unit"
      ],
      "properties": {
        "arrivals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})$"
          }
        },
        "service_minutes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}$"
        },
        "unit": {
          "const": "minute"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "rows"
      ],
      "properties": {
        "unit": {
          "const": "minute"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "car",
              "arrival",
              "start",
              "finish"
            ],
            "properties": {
              "car": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,5})$"
              },
              "arrival": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,5})$"
              },
              "start": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "finish": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    }
  }
}
