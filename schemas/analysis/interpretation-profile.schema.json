{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/analysis/interpretation-profile.schema.json",
  "title": "Writ Interpretation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "methodology_bundle_hash",
    "parameters",
    "decisions",
    "waivers",
    "status",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "methodology_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parameters": {
      "type": "object"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "choice", "rationale", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "choice": {},
          "alternatives_considered": {
            "type": "array",
            "items": {}
          },
          "rationale": {
            "type": "string"
          },
          "source_passage_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": ["proposed", "accepted", "contested", "superseded"]
          },
          "approved_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["diagnostic_code", "object_id", "rationale", "approved_by"],
        "properties": {
          "diagnostic_code": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status": {
      "enum": ["draft", "review", "approved", "withdrawn"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "canonical_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object"
    }
  }
}
