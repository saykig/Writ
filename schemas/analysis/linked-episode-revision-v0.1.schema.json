{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/analysis/linked-episode-revision-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "parent_episode",
    "successor_episode",
    "parent_reference",
    "external_revision",
    "relationship",
    "evidence_kind",
    "native_model_effect",
    "supersession"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "const": "linked_episode_revision"
    },
    "parent_episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "content", "sha256"],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "successor_episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "content", "sha256"],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parent_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_sha256", "observation_id", "reconsideration_id"],
      "properties": {
        "episode_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "reconsideration_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "external_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_run_sha256",
        "successor_run_sha256",
        "prior_input_sha256",
        "successor_input_sha256",
        "changed_field",
        "prior_value",
        "successor_value",
        "reason",
        "declared_by",
        "declared_at"
      ],
      "properties": {
        "prior_run_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "successor_run_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prior_input_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "successor_input_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_field": {
          "const": "service_minutes"
        },
        "prior_value": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}$"
        },
        "successor_value": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "declared_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_type", "actor_id"],
          "properties": {
            "actor_type": {
              "enum": ["human", "institution"]
            },
            "actor_id": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "declared_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "relationship": {
      "const": "explicit_reconsideration"
    },
    "evidence_kind": {
      "const": "model_generated"
    },
    "native_model_effect": {
      "const": "unchanged"
    },
    "supersession": {
      "const": "none_automatic"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
