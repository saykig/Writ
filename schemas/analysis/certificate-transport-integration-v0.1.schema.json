{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/analysis/certificate-transport-integration-v0.1.schema.json",
  "title": "Writ certificate transport integration record v0.1",
  "description": "A bounded portable record that binds one accepted shared-analysis revision/reassessment to a pinned Bellman certificate-transport request, candidate evidence, producer-time check, and checker-only replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "decision_lab",
    "binding",
    "model_binding",
    "shared_analysis",
    "request",
    "evidence",
    "producer_check"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "record_kind": { "const": "certificate_transport_integration" },
    "decision_lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "interface", "guarantee"],
      "properties": {
        "commit": { "const": "e5f77dfcf929708951f4673b3f394461ef09c752" },
        "interface": { "const": "certificate-transport-request.v1" },
        "guarantee": { "const": "expected-additive-total-cost-regret" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared_analysis_sha256",
        "revision_id",
        "analysis",
        "applicability_assessment_id",
        "reassessment_basis_sha256",
        "revision_impact_sha256",
        "prior_analysis_sha256",
        "target_analysis_sha256",
        "transport_source_certificate_sha256",
        "transport_target_certificate_sha256"
      ],
      "properties": {
        "shared_analysis_sha256": { "$ref": "#/$defs/sha256" },
        "revision_id": { "$ref": "#/$defs/nonEmptyString" },
        "analysis": { "$ref": "#/$defs/analysisAddress" },
        "applicability_assessment_id": { "$ref": "#/$defs/nonEmptyString" },
        "reassessment_basis_sha256": { "$ref": "#/$defs/sha256" },
        "revision_impact_sha256": { "$ref": "#/$defs/sha256" },
        "prior_analysis_sha256": { "$ref": "#/$defs/sha256" },
        "target_analysis_sha256": { "$ref": "#/$defs/sha256" },
        "transport_source_certificate_sha256": { "$ref": "#/$defs/sha256" },
        "transport_target_certificate_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "model_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_request_fields", "rationale"],
      "properties": {
        "changed_request_fields": {
          "description": "The complete deterministic source-to-target substantive diff path set across subject and policy. Subject name and premises are descriptive exemptions.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "shared_analysis": { "$ref": "#/$defs/encodedBytes" },
    "request": { "$ref": "#/$defs/encodedBytes" },
    "evidence": { "$ref": "#/$defs/encodedBytes" },
    "producer_check": { "$ref": "#/$defs/encodedBytes" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "encodedBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "content", "sha256"],
      "properties": {
        "encoding": { "const": "base64" },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "analysisAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "analysis_id"],
      "properties": {
        "bundle_id": { "$ref": "#/$defs/nonEmptyString" },
        "analysis_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
