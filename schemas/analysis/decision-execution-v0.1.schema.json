{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/analysis/decision-execution-v0.1.schema.json",
  "title": "Writ checked decision execution v0.1",
  "description": "A byte-bound candidate and a recorded mathematical check. A recipient must freshly check the candidate again; this record is not empirical support, human acceptance, or authority to act.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_sha256",
    "analysis_id",
    "analysis_sha256",
    "engine",
    "problem_sha256",
    "query_sha256",
    "candidate_result",
    "mathematical_check",
    "applicability",
    "human_review"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "case_id": { "$ref": "#/$defs/nonEmptyString" },
    "case_sha256": { "$ref": "#/$defs/sha256" },
    "analysis_id": { "$ref": "#/$defs/nonEmptyString" },
    "analysis_sha256": { "$ref": "#/$defs/sha256" },
    "engine": { "$ref": "#/$defs/engine" },
    "problem_sha256": { "$ref": "#/$defs/sha256" },
    "query_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_result": { "$ref": "#/$defs/encodedBytes" },
    "mathematical_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result"],
      "properties": {
        "status": { "const": "freshly_checked" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "status",
            "family_kind",
            "model_sha256",
            "query_sha256",
            "conclusion"
          ],
          "properties": {
            "operation": { "enum": ["compatibility", "decision"] },
            "status": {
              "enum": [
                "unresolved",
                "compatible",
                "incompatible",
                "uniformly_strictly_optimal",
                "uniformly_optimal",
                "complete_common_minimizing_set",
                "model_dependent"
              ]
            },
            "family_kind": { "enum": ["exact_family", "outer_enclosure"] },
            "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "query_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "conclusion": { "type": "object" }
          }
        }
      }
    },
    "applicability": { "$ref": "#/$defs/applicability" },
    "human_review": { "$ref": "#/$defs/humanReview" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "encodedBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "content", "sha256"],
      "properties": {
        "encoding": { "const": "base64" },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "repository",
        "commit",
        "semantics",
        "supported_operations",
        "runtime",
        "dependency"
      ],
      "properties": {
        "adapter": { "const": "writ-decision-lab-python.v1" },
        "repository": { "const": "https://github.com/saykig/writ-decision-lab" },
        "commit": { "const": "7215b53096bc487756f94f4ca87390716a14f2ee" },
        "semantics": { "const": "finite-linear-uncertainty.v1" },
        "supported_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["compatibility", "decision"] }
        },
        "runtime": { "const": "CPython 3.13" },
        "dependency": { "const": "scipy==1.17.0" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "changed_dependencies"],
      "properties": {
        "status": { "enum": ["supported", "needs_reassessment", "unknown", "contested"] },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "changed_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reviewer"],
      "properties": {
        "disposition": { "enum": ["unreviewed", "proposed", "accepted", "rejected"] },
        "reviewer": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "accepted" } } },
          "then": { "properties": { "reviewer": { "type": "string", "minLength": 1 } } },
          "else": { "properties": { "reviewer": { "type": "null" } } }
        }
      ]
    }
  }
}
