{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/compatibility/compliance-corpus-v2/commitment.schema.json",
  "title": "IdentifiedCommitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "institution",
    "summit_id",
    "commitment_id",
    "exact_text",
    "issue_areas",
    "source_passage_ids",
    "parser_version",
    "retrieval_date",
    "extraction_warnings"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "record_type": { "const": "identified_commitment" },
    "institution": { "enum": ["G7", "G20"] },
    "summit_id": { "type": "string", "minLength": 1 },
    "commitment_id": { "type": "string", "minLength": 1 },
    "exact_text": { "type": "string", "minLength": 1 },
    "issue_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_term", "vocabulary_mapping_id"],
        "properties": {
          "source_term": { "type": "string", "minLength": 1 },
          "vocabulary_mapping_id": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "source_passage_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "parser_version": { "type": "string", "minLength": 1 },
    "retrieval_date": { "type": "string", "format": "date" },
    "extraction_warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
