{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/compatibility/compliance-corpus-v2/evidence.schema.json",
  "title": "Historical Compliance Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "institution",
    "assessment_ref",
    "source_document_id",
    "source_url",
    "evidence_summary",
    "supporting_sources",
    "parser_version",
    "extraction_confidence",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "institution": { "enum": ["G7", "G20"] },
    "assessment_ref": { "type": "string", "minLength": 1 },
    "member": { "type": ["string", "null"] },
    "source_document_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "source_page_or_section": { "type": ["string", "null"] },
    "evidence_summary": { "type": "string", "minLength": 1 },
    "supporting_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_url"],
        "properties": {
          "source_url": { "type": "string", "format": "uri" },
          "title": { "type": ["string", "null"] },
          "page_or_section": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "analyst_reasoning": { "type": ["string", "null"] },
    "parser_version": { "type": "string", "minLength": 1 },
    "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
