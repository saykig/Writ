{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/compatibility/compliance-corpus-v2/reconciliation_manifest.schema.json",
  "title": "ReconciliationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "reconciliation_manifest_id",
    "institution",
    "summit_id",
    "inventory_source_id",
    "selected_subset_source_id",
    "extracted_inventory_count",
    "extracted_selected_count",
    "expected_inventory_count",
    "expected_selected_count",
    "validation_status",
    "reconciliation_warnings",
    "parser_version",
    "retrieval_date"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "record_type": { "const": "reconciliation_manifest" },
    "reconciliation_manifest_id": { "type": "string", "minLength": 1 },
    "institution": { "enum": ["G7", "G20"] },
    "summit_id": { "type": "string", "minLength": 1 },
    "inventory_source_id": { "type": "string", "minLength": 1 },
    "selected_subset_source_id": { "type": "string", "minLength": 1 },
    "extracted_inventory_count": { "type": "integer", "minimum": 0 },
    "extracted_selected_count": { "type": "integer", "minimum": 0 },
    "expected_inventory_count": { "type": ["integer", "null"], "minimum": 0 },
    "expected_selected_count": { "type": ["integer", "null"], "minimum": 0 },
    "validation_status": { "enum": ["valid", "incomplete", "conflicted", "unverified"] },
    "reconciliation_warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "parser_version": { "type": "string", "minLength": 1 },
    "retrieval_date": { "type": "string", "format": "date" }
  }
}
