{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/extensions/institutional-record.schema.json",
  "title": "Writ Institutional Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "corpus_id",
    "record_version",
    "family",
    "title",
    "subjects",
    "assertion",
    "topics",
    "scope",
    "evidence",
    "uncertainties",
    "provenance",
    "review_state",
    "institution_id",
    "institution_type",
    "mandate",
    "authority_sources",
    "jurisdictions",
    "functions",
    "operational_capacity"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "record_id": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
    },
    "corpus_id": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
    },
    "record_version": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/semanticVersion"
    },
    "family": { "const": "institutional" },
    "title": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
    },
    "subjects": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyStringArray"
    },
    "assertion": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/assertion"
    },
    "topics": { "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/stringArray" },
    "scope": { "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/scope" },
    "evidence": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/evidenceArray"
    },
    "uncertainties": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/uncertaintyArray"
    },
    "provenance": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/provenance"
    },
    "review_state": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/reviewState"
    },
    "institution_id": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
    },
    "institution_type": { "$ref": "#/$defs/institutionType" },
    "mandate": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
    },
    "authority_sources": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyStringArray"
    },
    "jurisdictions": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyStringArray"
    },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" },
      "minItems": 1,
      "uniqueItems": true
    },
    "operational_capacity": { "$ref": "#/$defs/operationalCapacity" },
    "decision_rights": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/stringArray"
    },
    "parent_institution_id": { "type": "string" },
    "subunit_ids": {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/stringArray"
    },
    "oversight_relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "institutional_relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "applicable_period": { "$ref": "#/$defs/applicablePeriod" }
  },
  "$defs": {
    "institutionType": {
      "enum": [
        "government_department",
        "federal_agency",
        "independent_agency",
        "advisory_body",
        "regulator",
        "standards_body",
        "research_body",
        "interagency_body",
        "organizational_unit",
        "other",
        "unknown"
      ]
    },
    "function": {
      "enum": [
        "standards_development",
        "measurement_science",
        "technical_guidance",
        "research",
        "evaluation",
        "coordination",
        "oversight",
        "grant_administration",
        "procurement_support",
        "other"
      ]
    },
    "capacityStatus": { "enum": ["established", "partial", "unknown", "contested"] },
    "operationalCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dimensions", "evidence_refs"],
      "properties": {
        "status": { "$ref": "#/$defs/capacityStatus" },
        "dimensions": {
          "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/stringArray"
        },
        "evidence_refs": {
          "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/stringArray"
        }
      }
    },
    "relationType": {
      "enum": [
        "part_of",
        "oversees",
        "supports",
        "advises",
        "coordinates_with",
        "reports_to",
        "implements_for"
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": { "$ref": "#/$defs/relationType" },
        "target_id": {
          "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "applicablePeriod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "format": "date" },
        "until": { "type": "string", "format": "date" }
      }
    }
  }
}
