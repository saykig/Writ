// Does the jurisdiction impose a binding model-evaluation duty on providers of
// advanced or general-purpose AI models?
//
// The reviewers of the EU-US pilot stated the test as a conjunction of four
// classified dimensions. This file is that test, written so it runs: a provision
// answers the question only if it is binding, currently applicable, addressed to
// a market provider, and about model evaluation. Each condition is read from a
// claim in the evidence snapshot, and every claim in the snapshot is linked to
// the retrieved text of the provision it classifies.
//
// The conjunction is the whole point. Dropping any one condition changes the
// answer: without `binding`, voluntary guidance counts; without `market_provider`,
// duties on government agencies and their vendors count; without
// `model_evaluation`, documentation and risk-assessment duties count. Those are
// the four collapses the human review was written to prevent, so they are stated
// here as conditions a reader can see and a reviewer can change.

language writ "0.1"
package pilot.eu_us_ai_evaluation version "1.0.0";

commitment MODEL_EVALUATION_DUTY {
  title "Binding model-evaluation duty on providers of advanced AI models";
  subjects {EuropeanUnion, UnitedStates};
  // Opens at the AI Act's publication in the Official Journal and closes at the
  // date the source documents behind this pilot were retrieved.
  evaluation_window [2024-07-12, 2026-07-27];
  // Open world: the corpus is not claimed to be every provision in force, so an
  // absent provision is absent, not evidence that no such provision exists.
  evidence_policy open_world;
  unknown_policy propagate;

  // Each claim classifies one provision, so provisions are counted separately.
  action_identity strict_separate by id;

  // The headline rule, as the reviewers stated it.
  let binding_duty: Int = count_distinct(claims where
    qualifiers.legal_force == binding
    and qualifiers.applicability_status == applicable
    and qualifiers.actor_type == market_provider
    and qualifiers.conduct_type == model_evaluation
    distinct_by subject_ref);

  // Held separately, because it is the answer to a different question. A duty
  // that binds an agency or a vendor is real; it is not a duty on the provider
  // that builds the model, and the pilot exists partly to keep the two apart.
  let government_duty: Int = count_distinct(claims where
    qualifiers.legal_force == binding
    and qualifiers.actor_type == federal_agency
    distinct_by subject_ref);

  score {
    result "+1" priority 20 when binding_duty >= 1 id duty_on_providers;
    result "0" priority 20 when binding_duty == 0 and government_duty >= 1
      id government_duty_only;
    result "-1" priority 20 when binding_duty == 0 and government_duty == 0
      id no_duty_found;
    otherwise unresolved "The retrieved corpus does not determine the answer.";
  }

  assert exhaustive over binding_duty in 0..20, government_duty in 0..20;
  assert non_overlapping over binding_duty in 0..20, government_duty in 0..20;
}
