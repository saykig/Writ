{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/release.schema.json",
  "title": "Writ Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "created_at",
    "evaluator_build_hash",
    "methodology_bundles",
    "interpretation_profiles",
    "evidence_snapshots",
    "receipts",
    "discrepancies",
    "source_objects",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "published",
        "withdrawn"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "evaluator_build_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "methodology_bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "interpretation_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "evidence_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "source_objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "aggregate_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "media_type",
          "hash"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "conformance_passed": {
          "type": "boolean"
        },
        "unwaived_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_discrepancy_count": {
          "type": "integer",
          "minimum": 0
        },
        "reproducibility_verified": {
          "type": "boolean"
        }
      }
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object"
    },
    "withdrawal_reason": {
      "type": "string"
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
