{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant.example/schemas/methodology-inventory.schema.json",
  "title": "G7 Chapter Methodology Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "commitment_id",
    "chapter",
    "subjects",
    "evaluation_window",
    "commitment_text",
    "definitions",
    "classifications",
    "score_guideline",
    "observed_results",
    "open_questions",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string"
    },
    "commitment_id": {
      "type": "string"
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "uri",
        "report_year"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "report_year": {
          "type": "integer"
        },
        "page_range": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        }
      }
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evaluation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "commitment_text": {
      "type": "string"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "source_passage_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_passage_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partner_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temporal_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attribution_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score_guideline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prose",
        "normalized_branches"
      ],
      "properties": {
        "prose": {
          "type": "string"
        },
        "normalized_branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "condition_text"
            ],
            "properties": {
              "result": {
                "enum": [
                  "-1",
                  "0",
                  "+1",
                  "not_applicable"
                ]
              },
              "condition_text": {
                "type": "string"
              },
              "source_passage_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "observed_results": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "-1",
          "0",
          "+1",
          "not_applicable"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "category",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "category": {
            "enum": [
              "rule_gap",
              "rule_overlap",
              "identity",
              "attribution",
              "time",
              "definition",
              "prose_metric_mismatch",
              "evidence",
              "other"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "proposed_resolution": {
            "type": "string"
          }
        }
      }
    },
    "review_status": {
      "enum": [
        "draft",
        "extracted",
        "reviewed",
        "approved"
      ]
    },
    "reviewer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
