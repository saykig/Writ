DATABASE_URL=postgresql://writ:writ@localhost:5432/writ
# DB tests run only when this is set explicitly (opt-in). It may point at the same
# database as DATABASE_URL; each suite is isolated in a disposable schema that is
# dropped on teardown, so it never touches the public schema.
WRIT_TEST_DATABASE_URL=postgresql://writ:writ@localhost:5432/writ
