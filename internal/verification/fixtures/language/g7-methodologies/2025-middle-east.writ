language writ "0.1"
package g7.kananaskis_2025.middle_east version "1.0.0";

commitment MIDDLE_EAST_PEACE {
  title "Support de-escalation and a political pathway";
  subjects G7Members;
  evaluation_window [2025-06-18, 2026-06-01];
  evidence_policy open_world;
  unknown_policy propagate;

  dimension de_escalation "Actions supporting an end to hostilities and humanitarian access";
  dimension political_pathway "Actions supporting a sustainable political solution";

  let de_escalation_met: Truth = dimension_met(de_escalation);
  let political_pathway_met: Truth = dimension_met(political_pathway);

  score {
    result "+1" priority 10 when de_escalation_met and political_pathway_met id both_dimensions;
    result "0" priority 10 when de_escalation_met or political_pathway_met id one_dimension intentional_overlap;
    result "-1" priority 10 when not de_escalation_met and not political_pathway_met id neither_dimension;
    otherwise unresolved "At least one dimension is unknown or contested.";
  }

  assert exhaustive over de_escalation_met in {true, false}, political_pathway_met in {true, false};
}
