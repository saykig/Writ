language writ "0.1"
package g7.kananaskis_2025.ai_sme.inclusive_up_to version "1.0.0";

commitment AI_SME_ADOPTION {
  title "Inclusive arithmetic reading of up to four strong actions";
  subjects G7Members;
  evaluation_window [2025-06-18, 2026-06-01];
  evidence_policy open_world;
  unknown_policy propagate;
  action_identity review_required by underlying_instrument_id, program_family_id;

  let strong_count: Int = count_distinct(actions where classification == strong distinct_by underlying_instrument_id);
  let weak_count: Int = count_distinct(actions where classification == weak distinct_by underlying_instrument_id);
  let counter_exists: Truth = exists(actions where classification == counter);

  score {
    result "+1" priority 10 when strong_count >= 5 id full;
    result "0" priority 10 when (strong_count between {0, 4}) or
      (weak_count between {3, 4}) id partial_inclusive_up_to;
    result "-1" priority 10 when counter_exists or
      (strong_count == 0 and weak_count <= 2) id none;
    otherwise unresolved "The source phrase remains operationally ambiguous.";
  }

  assert exhaustive over strong_count in 0..8, weak_count in 0..8, counter_exists in {true, false};
  assert non_overlapping over strong_count in 0..8, weak_count in 0..8, counter_exists in {true, false};
}

scenario zero_strong_low_weak_overlap for AI_SME_ADOPTION {
  given strong_count = 0;
  given weak_count = 0;
  given counter_exists = false;
  expect diagnostic WRT-SCORE-OVERLAP;
}
