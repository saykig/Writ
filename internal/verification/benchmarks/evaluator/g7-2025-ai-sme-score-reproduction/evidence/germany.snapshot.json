    }
  ],
  "passages": [
    {
      "id": "passage-germany-bmz-data-strategy",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 179,
      "quote": "The BMZ Data Strategy announced a ministry-wide plan to introduce AI in administration and data analysis, but was based on data collected in September 2024, indicating limited recent progress.",
      "anchor_hash": "sha256:415f0b6c8078c1cc1ebae1bf1d7c5406d1a21c9d32fc22a17323db579cfa6951",
      "language": "en"
    },
    {
      "id": "passage-germany-mittelstand-digital-congress",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 179,
      "quote": "The Mittelstand Digital Congress had AI experts educate SMEs on how to safely integrate AI technology into their businesses.",
      "anchor_hash": "sha256:3df8455c321d8dcf9e59bfdd02bde40c74b7fcc61faa757ac6ded6d977658707",
      "language": "en"
    },
    {
      "id": "passage-germany-european-digital-sovereignty-summit",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 179,
      "quote": "Germany and France co-hosted the European Summit on Digital Sovereignty in Berlin with over 1,000 participants including digital ministers from 23 EU member states.",
      "anchor_hash": "sha256:d9a05460f2a02be1b0d9196888c9563d23a62da9bf2395b31086382300cecbf7",
      "language": "en"
    },
    {
      "id": "passage-germany-canada-germany-digital-alliance",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 179,
      "quote": "Minister Wildberger and Minister Solomon advanced a Canada-Germany Digital Alliance committing to a Joint Declaration of Intent on AI covering compute infrastructure, AI adoption and talent mobility, including SMEs.",
      "anchor_hash": "sha256:a48d8b5b7a3cef5fee5d0ebe3a86b09f6eed2f18991865e9497ada96ee995ecb",
      "language": "en"
    },
    {
      "id": "passage-germany-sme-ai-adoption-blueprint",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 179,
      "quote": "The G7 SME AI Adoption Blueprint set out coordinated measures and financial supports for resilient SME-focused AI adoption ecosystems.",
      "anchor_hash": "sha256:f72484971113742e51dfe5556fac9f6632e314878c1779c91076977cc915f05b",
      "language": "en"
    },
    {
      "id": "passage-germany-g7-sme-ai-toolkit",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 180,
      "quote": "The G7 published the Toolkit for Small- and Medium-Sized Enterprises Deploying Artificial Intelligence with tailored resources for SME AI deployers.",
      "anchor_hash": "sha256:0f09e572722197c12f4390266268d0771a06a0bd3f13cf07b7135840854ddc45",
      "language": "en"
    },
    {
      "id": "passage-germany-eif-german-equity",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 180,
      "quote": "The BMWE and the European Investment Fund expanded the EIF German Equity program, providing EUR1.6 billion in additional financing for technology-based startups and SMEs.",
      "anchor_hash": "sha256:cc6b3d610a26f65be0b7668fff3a2c75c022e3a1e2ceee2f65989d4acf6b933f",
      "language": "en"
    },
    {
      "id": "passage-germany-canada-germany-jdi-sovereign-alliance",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 180,
      "quote": "Canada and Germany signed a Joint Declaration of Intent on AI and launched the Sovereign Technology Alliance, although they do not provide direct, targeted support for SME AI adoption.",
      "anchor_hash": "sha256:f012258c464a944722fb9e0029b1b7a7c77f0fd907b4379b26a3e8a5f48ba638",
      "language": "en"
    },
    {
      "id": "passage-germany-india-germany-ai-pact",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 180,
      "quote": "Ministers Wildberger and Vaishnaw agreed to establish the India-Germany AI Pact, aiming to increase the rapid adoption of AI for start-ups, tech firms and SMEs.",
      "anchor_hash": "sha256:dc572512be1ac8d85666859850943c08e86a22dd0d3cef2037e3067c40688771",
      "language": "en"
    },
    {
      "id": "passage-germany-ai-funding-guideline-consultation",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 181,
      "quote": "The Federal Ministry for Digital Affairs initiated a public consultation for SMEs, research centers and public institutions to create a funding guideline promoting AI for commercial applications.",
      "anchor_hash": "sha256:bc99eada8e10c34b005028baa040febf1adcc3b65c1bf600ebc5fc2ec293f015",
      "language": "en"
    },
    {
      "id": "passage-germany-zukunftstag-mittelstand",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 181,
      "quote": "The Zukunftstag Mittelstand 2026 showcased practical AI and data solutions and digital transformation tools tailored to SMEs to advance adoption of AI, cloud computing and digital infrastructure.",
      "anchor_hash": "sha256:4917c4dec02b7325da57f7a2aa089b80e1142b69e169c6dbaff2dbad4b95e770",
      "language": "en"
    }
  ],
