      "media_type": "application/pdf",
      "retrieved_at": "2026-07-01T00:00:00Z",
      "issued_at": "2026-06-13T00:00:00Z",
      "sha256": "sha256:9e88bb3633d97fe906405f23f63031416c3ea4cf75d8cbc916685ea552e2c85a",
      "publisher": "G7 Research Group",
