  "passages": [
    {
      "id": "passage-france-ai-pioneers",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 177,
      "quote": "France launched the AI Pioneers program financing domestic project proposals, providing between EUR3 million and EUR8 million to selected enterprises over three years.",
      "anchor_hash": "sha256:4d6ed71845c499857d6303c0232a4b86fd08146a8eb1319620f1a3ccccbb05be",
      "language": "en"
    },
    {
      "id": "passage-france-osez-lia",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 177,
      "quote": "The Osez l'IA plan accelerates AI adoption in SMEs through networking events, an AI academy training professionals, and help identifying relevant AI solutions.",
      "anchor_hash": "sha256:c5e9099dbbf12e03f556dd4f5623a61aaeec83556a24a9f77e3b2e7a3de6ad91",
      "language": "en"
    },
    {
      "id": "passage-france-ai-academy-small-business",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 177,
      "quote": "An action plan to revitalize small businesses added an AI Academy letting SMEs access user-friendly AI tools with a network of ambassadors.",
      "anchor_hash": "sha256:a1f2a0f5224248e7a6bd097586d31b49898fb7c56929d679c0378143a4e87750",
      "language": "en"
    },
    {
      "id": "passage-france-piiec-ai-innovation",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 177,
      "quote": "France launched the PIIEC framework letting EU member states finance private AI innovation projects, helping local French SMEs access funding for advanced AI technology.",
      "anchor_hash": "sha256:85b6d697b69917622d93e93a50564eb3342d378ca7ad1e785e97e77a15654dda",
      "language": "en"
    },
    {
      "id": "passage-france-data-center-sme-deployment",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 178,
      "quote": "Minister Le Henanff reconvened stakeholders on increasing AI adoption in SMEs through data center sites, providing support to 52 companies implementing AI.",
      "anchor_hash": "sha256:6472a9cac9436e8cc46b3918bc2054f7ad7aa689eee769f31d7401bbdd2cc60e",
      "language": "en"
    },
    {
      "id": "passage-france-bull-acquisition",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 178,
      "quote": "France announced the state's EUR404 million acquisition of the AI computing brand Bull to facilitate AI integration into SMEs.",
      "anchor_hash": "sha256:8b9d247a4ea74d0461334358a1e2e9222419e1d0e106f6fdd89e42114f3ff0c7",
      "language": "en"
    },
    {
      "id": "passage-france-amd-compute-loi",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 178,
      "quote": "France and AMD signed a letter of intent to expand access to AI compute, supporting the Alice Recoque exascale supercomputer with hardware, software and training for startups.",
      "anchor_hash": "sha256:2484d1f56a18a0be29a0a40dce4ccfc97339fb27c650ae201f1994c3edd016c3",
      "language": "en"
    }
  ],
