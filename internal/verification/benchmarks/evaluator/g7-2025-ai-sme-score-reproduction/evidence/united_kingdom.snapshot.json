  "passages": [
    {
      "id": "passage-united_kingdom-made-in-uk-awards",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 186,
      "quote": "The Department for Business and Trade announced 12 SMEs as recipients of the 2025 Made in the UK, Sold to the World Awards, including firms utilizing AI in their products.",
      "anchor_hash": "sha256:b359da5ae5b311f2005fe1c9aefc6d8ad6be636530676434b9bf97a914b2ad72",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-regulatory-innovation-office",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 186,
      "quote": "Technology Secretary Kyle announced plans for the Regulatory Innovation Office to reduce stringent regulations on AI adoption for SMEs in fintech via a unified digital library.",
      "anchor_hash": "sha256:bd9354345c911e850f4bb6db856991e28d3f30bfc1eda82cf1c5784927d58abb",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-compute-roadmap",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 186,
      "quote": "The DSIT and UKRI Compute Roadmap pledges to expand the UK's AI Research Resource system twenty-fold over the next five years, supporting SME access to compute and AI.",
      "anchor_hash": "sha256:ab499565721d9606c651521f062f15f5ae7b82e8f82f20ce2aa39d486da54b41",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-uk-us-tech-prosperity-deal",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 186,
      "quote": "The UK and US agreed the Tech Prosperity Deal to boost data centres and AI startups and create a North East AI Growth Zone expanding SME access to affordable compute.",
      "anchor_hash": "sha256:0e76630bf1dfa515fdc061c03fbbc5dcbce49005d69652c6834ad2556ddcb165",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-regional-tech-booster",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 186,
      "quote": "The DSIT launched the Regional Tech Booster programme supporting projects that help SMEs adopt AI through investment events and a start-up support scheme.",
      "anchor_hash": "sha256:c3ae1ed7ccd8663f4e110ce99b4b000e0bbb23d7f0c906d69134406278e3fdec",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-local-innovation-partnerships-fund",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 186,
      "quote": "Science and Technology Secretary Kendall announced GBP20 million each for Greater Manchester, the West Midlands and Glasgow for AI-based SMEs.",
      "anchor_hash": "sha256:918e630304bba915022813d3b0b76bdcbb38c8ed7ba0a54869a48f1687275d69",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-ai-growth-lab",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 187,
      "quote": "Technology Secretary Kendall announced the AI Growth Lab to cut red tape by piloting responsible AI to be adopted by people and businesses.",
      "anchor_hash": "sha256:4e977189f7226baa388166ca3001693f64bc2ef734f6c69fb842491ecaf3436a",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-ai-skills-framework",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 187,
      "quote": "Skills England announced the AI Skills Framework, Adoption Pathway and Employer Checklist to support AI adoption in various sectors, including for SMEs.",
      "anchor_hash": "sha256:7f7fa3ae0422a08b8949bc90d0a65f4155c6791abddd62bc184180bdf2b368bb",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-dawn-supercomputer",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 187,
      "quote": "The DSIT announced a GBP36 million injection into Cambridge's DAWN supercomputer under the AI Opportunities Action Plan to help SMEs access supercomputing capabilities.",
      "anchor_hash": "sha256:195b4303ea701067da844435394c882e7827cddc34e74fe5340c01bd375e270f",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-free-ai-foundations-training",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 187,
      "quote": "The DSIT expanded free AI foundations training for all workers, including at least 2 million employees from SMEs.",
      "anchor_hash": "sha256:10b2d9ddb9c870de6c4b86c5f176fb9457394244bf34b85778ae91e3893dd885",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-youth-employment-ai-apprenticeship",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 187,
      "quote": "Work and Pensions Secretary McFadden announced a GBP1 billion youth employment investment including an 18-month AI and automation practitioner apprenticeship.",
      "anchor_hash": "sha256:6a31d1555cf4b6b0fec6033a430830db08cf938eb58e31d8dfb058575d623858",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-ai-upskilling-challenge-fund",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 187,
      "quote": "The DSIT launched an GBP800,000 AI Upskilling Challenge Fund and a Healthcare Living Lab with Cisco to provide SME workers with training in the usage of AI technology.",
      "anchor_hash": "sha256:ce1dbcf73f29f7f33eba5331f01419b175ca2f8bd4ec6141ce571df02d62a04f",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-frontier-ai-discovery",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 188,
      "quote": "Innovate UK launched the Frontier AI Discovery funding competition, making up to GBP2.5 million available to UK organizations including SMEs for AI feasibility studies.",
      "anchor_hash": "sha256:d6b967ba860288db770ce2352d7655d2d21b22e30822df64c6ceeeb3ddada8b7",
      "language": "en"
    },
    {
      "id": "passage-united_kingdom-sovereign-ai-initiative",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 188,
      "quote": "The DSIT launched the GBP500 million Sovereign AI initiative supporting domestic AI companies including startups and SMEs with direct investment, supercomputing access and one million GPU hours.",
      "anchor_hash": "sha256:c807fd6280c47f733605e8f5cfd35f5d72444417c709a8bfa8c34c8d5b5161b4",
      "language": "en"
    }
  ],
