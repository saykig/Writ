  "passages": [
    {
      "id": "passage-european_union-ai-act-advisory-forum",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 190,
      "quote": "The European Commission launched a call for stakeholders to join the AI Act Advisory Forum, a platform for SMEs to voice concerns and suggestions.",
      "anchor_hash": "sha256:4a563867c0cea4c8574feb658f4feb8c5d5c1f0ea19a0b37d427655d18f74efb",
      "language": "en"
    },
    {
      "id": "passage-european_union-apply-ai-strategy",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 190,
      "quote": "The Commission launched the Apply AI Strategy with sector-specific investment initiatives to support SMEs implementing and scaling AI solutions using European open-source AI.",
      "anchor_hash": "sha256:ccc85efade3783afed1fa49ae7fb2f7402ba43252bae3267ad6245b784988b9c",
      "language": "en"
    },
    {
      "id": "passage-european_union-ai-in-science-raise",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 190,
      "quote": "The AI in Science strategy uses the RAISE virtual institute, with EUR600 million from Horizon Europe to support startup access to computational power.",
      "anchor_hash": "sha256:e14229e7202b4741d4d2cfd71c33356cea9b8ad5f6f7d3edbf2d69dc2415f9de",
      "language": "en"
    },
    {
      "id": "passage-european_union-ai-act-service-desk",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 190,
      "quote": "The Commission launched the AI Act Service Desk and Single Information Platform with a Compliance Checker and AI Act Explorer to help SMEs navigate AI regulations.",
      "anchor_hash": "sha256:28bdff7fd61b5969ef7b81a38b28088b73f25a8104ad9fd74b1f4c8ca0872da7",
      "language": "en"
    },
    {
      "id": "passage-european_union-ai-factories-six-new",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 190,
      "quote": "The Commission announced building six new AI Factories providing AI-optimized supercomputers and technical support to startups and SMEs.",
      "anchor_hash": "sha256:3f7c2c3fc42e1d3925d95aa8899b70388c3dba68e1cc73f170d0a1a687faf0cb",
      "language": "en"
    },
    {
      "id": "passage-european_union-seventh-ai-pact-webinar",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 191,
      "quote": "The Commission announced the seventh AI Pact webinar on AI Innovation for SMEs and startups, explaining how to navigate regulatory compliance.",
      "anchor_hash": "sha256:490b45da63e0773bb3167168894dee4fe589cba500cf87c92f932098972971bb",
      "language": "en"
    },
    {
      "id": "passage-european_union-european-data-union-strategy",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 191,
      "quote": "The European Data Union Strategy increases the availability of cheap, high-quality data sets to train AI tools in SMEs and streamlines data regulations.",
      "anchor_hash": "sha256:9f0e9f3bdfd5e750cf512e85609def194170eef439aa49ada8d9711a2ae2242b",
      "language": "en"
    },
    {
      "id": "passage-european_union-apply-ai-manufacturing-tef",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 191,
      "quote": "The Commission funded Acceleration Pipelines and Testing and Experimentation Facilities allowing SMEs to trial, validate and certify AI-enabled technologies.",
      "anchor_hash": "sha256:3231a2f981d7e78ca7a861b558a0fdd1d2acf66ac689ce6535d7af327e111dcd",
      "language": "en"
    },
    {
      "id": "passage-european_union-eesc-commercialization-call",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 191,
      "quote": "The European Economic and Social Committee called for rapid measures to accelerate AI commercialization for SMEs, endorsing the Apply AI Strategy.",
      "anchor_hash": "sha256:9e755202f5bdcbd1b2ce7332d34ce029d7e7d52e9ba970d37966565b3431f419",
      "language": "en"
    },
    {
      "id": "passage-european_union-apply-ai-framework-innovation-hubs",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 191,
      "quote": "The Commission advanced the Apply AI Strategy with sector-specific measures, European Digital Innovation Hubs, AI Factories and regulatory sandboxes to boost AI adoption among SMEs.",
      "anchor_hash": "sha256:63c7bc9f304bb9602071e92f6be75d147dd235949dd520b80779f41ec86464df",
      "language": "en"
    },
    {
      "id": "passage-european_union-ai-continent-action-plan",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 192,
      "quote": "The AI Continent Action Plan expands AI computing infrastructure through AI Factories and Gigafactories and supports AI adoption among enterprises via the AI Skills Academy and Digital Innovation Hubs.",
      "anchor_hash": "sha256:4fc9f23493968279944b23dd4fea4611b47dced67ef44a9f26a7f841cec3658e",
      "language": "en"
    }
  ],
