  ],
  "passages": [
    {
      "id": "passage-japan-ai-act",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 184,
      "quote": "Japan fully enforced the Act on Promotion of Research and Development, and Utilization of AI-related Technology, a general AI law formulating AI regulations and supporting responsible AI integration within SMEs and the wider private sector.",
      "anchor_hash": "sha256:b068a2b5245cb460415f87d74d2e2539e4476da77653f3c4183881eeceb44a64",
      "language": "en"
    },
    {
      "id": "passage-japan-ai-strategy-headquarters",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 184,
      "quote": "Japan established the AI Strategy Headquarters to promote secure integration of AI into businesses, particularly SMEs, addressing labor shortages, supply-chain analytics and market access.",
      "anchor_hash": "sha256:48d84b28197f4d4ecf7b18565812d483c83db97510e51c335f44669ad65dcc32",
      "language": "en"
    },
    {
      "id": "passage-japan-oecd-labour-market-report",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 184,
      "quote": "An OECD report identified barriers to SME AI adoption and listed Japanese measures ranging from 2015 to 2025, indicating limited recent progress and not fulfilling compute access.",
      "anchor_hash": "sha256:596eaf1ca82bdf0a547901503768d6e8fd3909b7d68f3940c64a5ba7ed8cc2bc",
      "language": "en"
    },
    {
      "id": "passage-japan-sme-ai-adoption-blueprint",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 184,
      "quote": "The G7 SME AI Adoption Blueprint set out coordinated measures for resilient SME-focused AI adoption ecosystems.",
      "anchor_hash": "sha256:8e7b127bd0bcd0bca028b44ab8390958e4215ba9a25717b174c0cf863e96aff1",
      "language": "en"
    },
    {
      "id": "passage-japan-g7-sme-ai-toolkit",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 185,
      "quote": "The G7 published the Toolkit for Small- and Medium-Sized Enterprises Deploying Artificial Intelligence with tailored resources for SME AI deployers.",
      "anchor_hash": "sha256:4cf1eaaf1dd10ded1a5105caa034238247dd0c8a26b99dfb703a337cdeb22c8d",
      "language": "en"
    },
    {
      "id": "passage-japan-first-basic-ai-plan",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 185,
      "quote": "Japan approved its first basic plan on AI, a national framework to expand AI use including measures supporting the uptake of AI tools within enterprises.",
      "anchor_hash": "sha256:064fb557331eaacb410698dbbc1b9cca5e27e82df53e6ebde4c417145518381b",
      "language": "en"
    },
    {
      "id": "passage-japan-gennai-government-pilot",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 185,
      "quote": "The Digital Agency launched a large-scale pilot for the government AI system GENNAI across ministries, whose impact on private-sector SMEs remains indirect.",
      "anchor_hash": "sha256:4a1d459d02f3430096efe37bb111bf4eaf23ce97d29ad90af157258efa58ee81",
      "language": "en"
    }
  ],
