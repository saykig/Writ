    "description": "Reviewed AI-for-SMEs evidence for Japan, 2025 G7 Kananaskis final compliance chapter 4."
  },
  "document_versions": [
    {
      "id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "document_id": "doc-g7-2025-kananaskis-final-compliance",
