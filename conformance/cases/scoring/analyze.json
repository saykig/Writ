[
  {
    "id": "score.analyze.ai-sme.literal",
    "area": "scoring",
    "kind": "score.analyze",
    "description": "Bounded analysis of the AI-for-SMEs literal program finds the published gap (0 strong, 5 weak, no counter) and two counteraction overlaps where the -1 `none` branch coincides with a positive branch (§19 deterministic witnesses)",
    "input": {
      "program": {
        "rules": [
          {
            "id": "full",
            "priority": 10,
            "result": "+1",
            "when": {
              "kind": "compare",
              "op": "gte",
              "left": { "kind": "ref", "path": "strong_count" },
              "right": { "kind": "literal", "value": 5 }
            }
          },
          {
            "id": "partial",
            "priority": 10,
            "result": "0",
            "when": {
              "kind": "nary",
              "op": "or",
              "operands": [
                {
                  "kind": "nary",
                  "op": "and",
                  "operands": [
                    {
                      "kind": "compare",
                      "op": "gte",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 1 }
                    },
                    {
                      "kind": "compare",
                      "op": "lte",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 4 }
                    }
                  ]
                },
                {
                  "kind": "nary",
                  "op": "and",
                  "operands": [
                    {
                      "kind": "compare",
                      "op": "eq",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 0 }
                    },
                    {
                      "kind": "compare",
                      "op": "gte",
                      "left": { "kind": "ref", "path": "weak_count" },
                      "right": { "kind": "literal", "value": 3 }
                    },
                    {
                      "kind": "compare",
                      "op": "lte",
                      "left": { "kind": "ref", "path": "weak_count" },
                      "right": { "kind": "literal", "value": 4 }
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "none",
            "priority": 10,
            "result": "-1",
            "when": {
              "kind": "nary",
              "op": "or",
              "operands": [
                { "kind": "ref", "path": "counter_exists" },
                {
                  "kind": "nary",
                  "op": "and",
                  "operands": [
                    {
                      "kind": "compare",
                      "op": "eq",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 0 }
                    },
                    {
                      "kind": "compare",
                      "op": "lte",
                      "left": { "kind": "ref", "path": "weak_count" },
                      "right": { "kind": "literal", "value": 2 }
                    }
                  ]
                }
              ]
            }
          }
        ],
        "otherwise": { "result": "unresolved", "message": "gap" }
      },
      "domains": {
        "strong_count": [0, 1, 2, 3, 4, 5, 6],
        "weak_count": [0, 1, 2, 3, 4, 5, 6],
        "counter_exists": [false, true]
      }
    },
    "expected": [
      {
        "code": "COV-SCORE-GAP",
        "severity": "error",
        "witness": { "counter_exists": false, "strong_count": 0, "weak_count": 5 }
      },
      {
        "code": "COV-SCORE-OVERLAP",
        "severity": "error",
        "witness": { "counter_exists": true, "strong_count": 0, "weak_count": 3 }
      },
      {
        "code": "COV-SCORE-OVERLAP",
        "severity": "error",
        "witness": { "counter_exists": true, "strong_count": 5, "weak_count": 0 }
      }
    ]
  },
