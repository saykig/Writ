[
  {
    "id": "score.ai-sme.literal.gap",
    "area": "scoring",
    "kind": "score.evaluate",
    "description": "AI-for-SMEs literal reading: 0 strong, 5 weak, no counteraction falls in the published rule text's gap and stays unresolved (never forced to a score)",
    "input": {
      "program": {
        "rules": [
          {
            "id": "full",
            "priority": 10,
            "result": "+1",
            "when": {
              "kind": "compare",
              "op": "gte",
              "left": { "kind": "ref", "path": "strong_count" },
              "right": { "kind": "literal", "value": 5 }
            }
          },
          {
            "id": "partial",
            "priority": 10,
            "result": "0",
            "when": {
              "kind": "nary",
              "op": "or",
              "operands": [
                {
                  "kind": "nary",
                  "op": "and",
                  "operands": [
                    {
                      "kind": "compare",
                      "op": "gte",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 1 }
                    },
                    {
                      "kind": "compare",
                      "op": "lte",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 4 }
                    }
                  ]
                },
                {
                  "kind": "nary",
                  "op": "and",
                  "operands": [
                    {
                      "kind": "compare",
                      "op": "eq",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 0 }
                    },
                    {
                      "kind": "compare",
                      "op": "gte",
                      "left": { "kind": "ref", "path": "weak_count" },
                      "right": { "kind": "literal", "value": 3 }
                    },
                    {
                      "kind": "compare",
                      "op": "lte",
                      "left": { "kind": "ref", "path": "weak_count" },
                      "right": { "kind": "literal", "value": 4 }
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "none",
            "priority": 10,
            "result": "-1",
            "when": {
              "kind": "nary",
              "op": "or",
              "operands": [
                { "kind": "ref", "path": "counter_exists" },
                {
                  "kind": "nary",
                  "op": "and",
                  "operands": [
                    {
                      "kind": "compare",
                      "op": "eq",
                      "left": { "kind": "ref", "path": "strong_count" },
                      "right": { "kind": "literal", "value": 0 }
                    },
                    {
                      "kind": "compare",
                      "op": "lte",
                      "left": { "kind": "ref", "path": "weak_count" },
                      "right": { "kind": "literal", "value": 2 }
                    }
                  ]
                }
              ]
            }
          }
        ],
        "otherwise": {
          "result": "unresolved",
          "message": "The published rule text does not cover this state."
        }
      },
      "facts": { "strong_count": 0, "weak_count": 5, "counter_exists": false }
    },
    "expected": {
      "result": "unresolved",
      "status": "incomplete",
      "matchedRuleId": null,
      "diagnostics": []
    }
  },
