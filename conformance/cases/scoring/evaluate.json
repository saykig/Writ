  {
    "id": "score.overlap.same-result",
    "area": "scoring",
    "kind": "score.evaluate",
    "description": "Two equal-priority branches are both true and agree on the result; the result is selected with a benign same-result overlap notice (§12 step 4)",
    "input": {
      "program": {
        "rules": [
          {
            "id": "a",
            "priority": 10,
            "result": "+1",
            "when": {
              "kind": "compare",
              "op": "gte",
              "left": { "kind": "ref", "path": "x" },
              "right": { "kind": "literal", "value": 1 }
            }
          },
          {
            "id": "b",
            "priority": 10,
            "result": "+1",
            "when": {
              "kind": "compare",
              "op": "gte",
              "left": { "kind": "ref", "path": "x" },
