[
  {
    "id": "temporal.overlaps.true",
    "area": "temporal",
    "kind": "expr.evaluateTruth",
    "description": "Two intervals that share time overlap: [Jan..Mar] overlaps [Feb..Apr]",
    "input": {
      "expr": {
        "kind": "compare",
        "op": "overlaps",
        "left": { "kind": "literal", "value": { "start": "2025-01-01", "end": "2025-03-01" } },
        "right": { "kind": "literal", "value": { "start": "2025-02-01", "end": "2025-04-01" } }
      }
    },
    "expected": "true"
  },
  {
    "id": "temporal.overlaps.false",
    "area": "temporal",
    "kind": "expr.evaluateTruth",
    "description": "Disjoint intervals do not overlap: [Jan..Feb] overlaps [Mar..Apr]",
    "input": {
      "expr": {
        "kind": "compare",
        "op": "overlaps",
        "left": { "kind": "literal", "value": { "start": "2025-01-01", "end": "2025-02-01" } },
        "right": { "kind": "literal", "value": { "start": "2025-03-01", "end": "2025-04-01" } }
      }
    },
    "expected": "false"
  },
  {
    "id": "temporal.overlaps.touching-days",
    "area": "temporal",
    "kind": "expr.evaluateTruth",
    "description": "Date-only endpoints widen to whole days, so intervals meeting on a shared day overlap",
    "input": {
      "expr": {
        "kind": "compare",
        "op": "overlaps",
        "left": { "kind": "literal", "value": { "start": "2025-01-01", "end": "2025-02-01" } },
        "right": { "kind": "literal", "value": { "start": "2025-02-01", "end": "2025-03-01" } }
      }
    },
    "expected": "true"
  }
]
