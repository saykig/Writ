        "left": { "kind": "literal", "value": "hello" },
        "right": { "kind": "literal", "value": 5 }
      }
    },
    "expected": { "truth": "unknown", "diagnostics": ["COV-LINT-TYPE"] }
  },
  {
    "id": "diag.unit-mismatch",
    "area": "diagnostics",
    "kind": "expr.evaluate",
    "description": "A currency mismatch raises the stable COV-LINT-UNIT code and yields unknown (section 10)",
    "input": {
      "expr": {
        "kind": "compare",
        "op": "gte",
        "left": { "kind": "ref", "path": "a" },
        "right": { "kind": "ref", "path": "b" }
      },
      "facts": {
        "a": { "value": "10", "currency": "CAD", "bound": "exact" },
        "b": { "value": "10", "currency": "USD", "bound": "exact" }
      }
    },
    "expected": { "truth": "unknown", "diagnostics": ["COV-LINT-UNIT"] }
  },
  {
    "id": "diag.missing-collection",
    "area": "diagnostics",
    "kind": "count.interval",
    "description": "A query over an undeclared collection raises COV-LINT-MISSING-REFERENCE and produces no count interval",
    "input": {
      "query": { "kind": "query", "operation": "count", "collection": "ghosts" },
      "collections": {}
    },
    "expected": {
      "interval": null,
      "blocking": false,
      "diagnostics": ["COV-LINT-MISSING-REFERENCE"]
    }
  }
