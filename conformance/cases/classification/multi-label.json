[
  {
    "id": "classify.multi-label.true-set",
    "area": "classification",
    "kind": "classify.evaluate",
    "description": "A multi_label block returns every true label and preserves unknown and contested labels separately (§6.2)",
    "input": {
      "block": {
        "id": "tags",
        "mode": "multi_label",
        "rules": [
          {
            "id": "r_a",
            "label": "alpha",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flagA" },
              "right": { "kind": "literal", "value": true }
            }
          },
          {
            "id": "r_b",
            "label": "beta",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flagB" },
              "right": { "kind": "literal", "value": true }
            }
          },
          {
            "id": "r_c",
            "label": "gamma",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flagC" },
              "right": { "kind": "literal", "value": true }
            }
          }
        ]
      },
      "facts": { "flagA": true, "flagB": false }
    },
    "expected": {
      "label": null,
      "labels": ["alpha"],
      "unknownLabels": ["gamma"],
      "contestedLabels": [],
      "status": "supported",
      "diagnostics": []
    }
  }
]
