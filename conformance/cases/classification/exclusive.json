[
  {
    "id": "classify.exclusive.unique-priority",
    "area": "classification",
    "kind": "classify.evaluate",
    "description": "Two labels are true; the uniquely highest-priority one is selected (§6.1). The lower-priority true label is recorded but not selected.",
    "input": {
      "block": {
        "id": "impl_stage",
        "mode": "exclusive",
        "rules": [
          {
            "id": "r_high",
            "label": "funded",
            "priority": 20,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flag" },
              "right": { "kind": "literal", "value": true }
            }
          },
          {
            "id": "r_low",
            "label": "announced",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flag" },
              "right": { "kind": "literal", "value": true }
            }
          }
        ]
      },
      "facts": { "flag": true }
    },
    "expected": {
      "label": "funded",
      "labels": ["funded"],
      "unknownLabels": [],
      "contestedLabels": [],
      "status": "supported",
      "diagnostics": []
    }
  },
  {
    "id": "classify.exclusive.equal-priority-ambiguous",
    "area": "classification",
    "kind": "classify.evaluate",
    "description": "Two distinct labels of equal highest priority are both true: classification is unresolved with an ambiguity diagnostic (§6.1 step 4)",
    "input": {
      "block": {
        "id": "impl_stage",
        "mode": "exclusive",
        "rules": [
          {
            "id": "r_a",
            "label": "alpha",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flagA" },
              "right": { "kind": "literal", "value": true }
            }
          },
          {
            "id": "r_b",
            "label": "beta",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flagB" },
              "right": { "kind": "literal", "value": true }
            }
          }
        ]
      },
      "facts": { "flagA": true, "flagB": true }
    },
    "expected": {
      "label": null,
      "labels": [],
      "unknownLabels": [],
      "contestedLabels": [],
      "status": "ambiguous",
      "diagnostics": ["COV-EVAL-AMBIGUOUS"]
    }
  },
  {
    "id": "classify.exclusive.unknown-does-not-default",
    "area": "classification",
    "kind": "classify.evaluate",
    "description": "No label is true and one is unknown; the declared otherwise_label is NOT applied because it is not marked safe under open-world semantics. Unknown is never silently treated as false (§6.1 step 6).",
    "input": {
      "block": {
        "id": "impl_stage",
        "mode": "exclusive",
        "otherwise_label": "none",
        "rules": [
          {
            "id": "r_a",
            "label": "alpha",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flagA" },
              "right": { "kind": "literal", "value": true }
            }
          }
        ]
      },
      "facts": {}
    },
    "expected": {
      "label": null,
      "labels": [],
      "unknownLabels": ["alpha"],
      "contestedLabels": [],
      "status": "incomplete",
      "diagnostics": []
    }
  },
  {
    "id": "classify.exclusive.otherwise-safe",
    "area": "classification",
    "kind": "classify.evaluate",
    "description": "No label is true and none is unknown; the otherwise_label applies because it is explicitly safe under open-world semantics (§6.1 step 6)",
    "input": {
      "block": {
        "id": "impl_stage",
        "mode": "exclusive",
        "otherwise_label": "none",
        "otherwise_safe_under_open_world": true,
        "rules": [
          {
            "id": "r_a",
            "label": "alpha",
            "priority": 10,
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": { "kind": "ref", "path": "flagA" },
              "right": { "kind": "literal", "value": true }
            }
          }
        ]
      },
      "facts": { "flagA": false }
    },
    "expected": {
