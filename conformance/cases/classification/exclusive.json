      "diagnostics": []
    }
  },
  {
    "id": "classify.exclusive.contested-decisive",
    "area": "classification",
    "kind": "classify.evaluate",
    "description": "No label is true but a decisive label is contested: classification is contested (§6.1 step 5)",
    "input": {
      "block": {
        "id": "impl_stage",
        "mode": "exclusive",
        "rules": [
          {
            "id": "r_a",
