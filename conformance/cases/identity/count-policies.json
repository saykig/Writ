[
  {
    "id": "identity.strict-deduplicate.interval",
    "area": "identity",
    "kind": "count.interval",
    "description": "Two actions share key K1 and one has no resolvable key. strict_deduplicate merges the possible duplicate: distinct count [1,1] (§8)",
    "input": {
      "query": {
        "kind": "query",
        "operation": "count_distinct",
        "collection": "actions",
        "distinct_by": "key"
      },
      "collections": {
        "actions": [{ "id": "a1", "key": "K1" }, { "id": "a2", "key": "K1" }, { "id": "a3" }]
      },
      "identity": { "policy": "strict_deduplicate", "key_paths": ["key"] }
    },
    "expected": { "interval": { "min": 1, "max": 1 }, "blocking": false, "diagnostics": [] }
  },
  {
    "id": "identity.strict-separate.interval",
    "area": "identity",
    "kind": "count.interval",
    "description": "strict_separate counts the unknown-identity action as its own unit: distinct count [2,2] (§8)",
    "input": {
      "query": {
        "kind": "query",
        "operation": "count_distinct",
        "collection": "actions",
        "distinct_by": "key"
      },
      "collections": {
        "actions": [{ "id": "a1", "key": "K1" }, { "id": "a2", "key": "K1" }, { "id": "a3" }]
      },
      "identity": { "policy": "strict_separate", "key_paths": ["key"] }
    },
    "expected": { "interval": { "min": 2, "max": 2 }, "blocking": false, "diagnostics": [] }
  },
  {
    "id": "identity.propagate-uncertainty.interval",
    "area": "identity",
    "kind": "count.interval",
    "description": "propagate_uncertainty keeps both bounds: merged lower, separate upper, distinct count [1,2] (§8)",
    "input": {
      "query": {
        "kind": "query",
        "operation": "count_distinct",
        "collection": "actions",
        "distinct_by": "key"
      },
      "collections": {
        "actions": [{ "id": "a1", "key": "K1" }, { "id": "a2", "key": "K1" }, { "id": "a3" }]
      },
      "identity": { "policy": "propagate_uncertainty", "key_paths": ["key"] }
    },
    "expected": { "interval": { "min": 1, "max": 2 }, "blocking": false, "diagnostics": [] }
  },
  {
    "id": "identity.review-required.blocks",
    "area": "identity",
    "kind": "count.interval",
    "description": "review_required on a score-decisive possible duplicate blocks publication and raises WRT-LINT-IDENTITY rather than guessing (§8 default production profile)",
    "input": {
      "query": {
        "kind": "query",
        "operation": "count_distinct",
        "collection": "actions",
        "distinct_by": "key"
      },
      "collections": {
        "actions": [{ "id": "a1", "key": "K1" }, { "id": "a2", "key": "K1" }, { "id": "a3" }]
      },
      "identity": { "policy": "review_required", "key_paths": ["key"] },
      "scoreDecisive": true
    },
    "expected": {
      "interval": { "min": 1, "max": 2 },
      "blocking": true,
      "diagnostics": ["WRT-LINT-IDENTITY"]
    }
  },
  {
    "id": "identity.membership.uncertain-count",
    "area": "identity",
    "kind": "count.interval",
    "description": "A membership count keeps unknown membership visible: two definite members and one whose predicate is unknown gives [2,3] (§7, unknown widens the max only)",
    "input": {
      "query": {
        "kind": "query",
        "operation": "count",
        "collection": "actions",
        "where": {
          "kind": "compare",
          "op": "eq",
          "left": { "kind": "ref", "path": "member" },
          "right": { "kind": "literal", "value": true }
        }
      },
      "collections": {
        "actions": [{ "id": "m1", "member": true }, { "id": "m2", "member": true }, { "id": "m3" }]
      }
    },
    "expected": { "interval": { "min": 2, "max": 3 }, "blocking": false, "diagnostics": [] }
  }
]
