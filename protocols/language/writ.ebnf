(* Informative EBNF for the active evidence-bound Writ language.
   packages/language/writ.langium is the executable grammar authority. *)

Model            = "language", "writ", String,
                   "package", QName, "version", String, ";",
                   { Declaration } ;
Declaration      = Source | Concept | Record | Judgment ;

Source           = "source", Identifier, "{", { SourceProperty }, "}" ;
SourceProperty   = ( "uri", String
                   | "media_type", String
                   | "retrieved", DateTime
                   | "sha256", String ), ";" ;
Concept          = "concept", Identifier, [ ":", QName ], "{",
                   { Identifier, ( String | Number | Date | QName ), ";" }, "}" ;

Record           = "record", Identifier, ":", RecordFamily, "{",
                   { RecordMember }, "}" ;
RecordFamily     = "legal_policy" | "institutional" | Identifier ;
RecordMember     = CommonRecordMember | LegalPolicyBlock | InstitutionalBlock ;
CommonRecordMember =
                   "corpus", QName, ";"
                 | "version", String, ";"
                 | "title", String, ";"
                 | "subjects", SubjectList, ";"
                 | "assertion", AssertionMode, String, ";"
                 | "topics", TopicList, ";"
                 | "scope", Scope
                 | "evidence", "{", EvidenceReference, { EvidenceReference }, "}"
                 | "uncertainty", "{", { "item", UncertaintyType, String, ";" }, "}"
                 | "provenance", "{", "created_by", String, ";",
                   "created_at", Date, ";", "}"
                 | "review_state", ReviewState, ";" ;
SubjectList      = "{", { "subject", QName, "type", QName,
                   [ "label", String ], [ "role", String ], ";" }, "}"
                 | IdentifierList ;
EvidenceReference = "support", QName, "document_version", QName, "passage", QName,
                   "locator", String, "quote", String, "passage_hash", String,
                   "document_hash", String, "basis", EvidenceBasis, ";" ;
EvidenceBasis    = "direct" | "inferred" | "inherited" ;
UncertaintyType  = "unknown" | "contested" | "ambiguous" | "incomplete_evidence" ;
ReviewState      = "draft" | "reviewed" | "approved" | "superseded" | "withdrawn" ;

(* Family blocks preserve independent atomic institutional distinctions. *)
InstitutionalBlock = "institutional", "{", { InstitutionalProperty }, "}" ;
InstitutionalProperty =
                   "institution_id", QName, ";"
                 | "fact_type", ( "identity" | "placement" | "relationship" | "mission"
                   | "mandate" | "function" | "decision_right" | "operational_capacity" ), ";"
                 | "institution_type", QName, ";"
                 | "mission", StructuredValue
                 | "mandate", ( StructuredValue | String, ";" )
                 | "function", QName, ";"
                 | "functions", IdentifierList, ";"
                 | "decision_right", StructuredValue
                 | "decision_rights", StringList, ";"
                 | "operational_capacity", StructuredValue
                 | "record_link", StructuredValue
                 | Identifier, ( QName | StringList | IdentifierList | StructuredValue ), [ ";" ] ;
LegalPolicyBlock = "legal_policy", "{", { Identifier,
                   ( QName | String | Date | Number | StringList | IdentifierList | StructuredValue ),
                   [ ";" ] }, "}" ;

Judgment         = "judgment", Identifier, "{", { JudgmentMember }, "}" ;
JudgmentMember   = "target", [ "record" | "record_link" ], QName, ";"
                 | "type", QName, ";"
                 | "value", Literal, ";"
                 | "rationale", String, ";"
                 | "evidence_refs", IdentifierList, ";"
                 | "reviewer", String, ";"
                 | "status", ( "proposed" | "accepted" | "contested" | "superseded" ), ";"
                 | "created_at", Date, ";"
                 | "family_context", RecordFamily, ";"
                 | ( "supersedes" | "superseded_by_judgment_id" ), QName, ";"
                 | ( "supersedes_judgment_ids" | "related_judgment_ids" ), IdentifierList, ";" ;

Literal          = String | Number | Date | "true" | "false" | "unknown" | "contested" ;
IdentifierList   = "{", [ QName, { ",", QName }, [ "," ] ], "}" ;
StringList       = "{", [ String, { ",", String }, [ "," ] ], "}" ;
TopicList        = "{", [ ( QName | String ), { ",", ( QName | String ) }, [ "," ] ], "}" ;
Scope            = "{", { Identifier, ( String | StringList | IdentifierList | StructuredValue ),
                   [ ";" ] }, "}" ;
StructuredValue  = "{", { Identifier, ( Literal | QName | StringList | IdentifierList
                   | StructuredValue ), [ ";" ] }, "}" ;
AssertionMode    = "requires" | "permits" | "prohibits" | "defines" | "authorizes"
                 | "assigns" | "performs" | "states" | "observes" ;
QName            = Identifier, { ".", Identifier } ;
