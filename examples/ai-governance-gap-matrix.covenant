language covenant "0.1"
package science.ai_governance.gap_matrix version "1.0.0";

// The Gap Matrix (Sara Kim, cepheus "What We Owe to Each Other"), ported to
// Covenant. A frontier-AI governance field is scored on two weighted-ordinal
// axes — how concentrated the knowledge/control is, and how much public
// authority exists — from reviewed analyst assessments. The distance between
// them is the governance gap: who knows vs. who decides.
//
// Methodology of record: cepheus gap-matrix methodologyVersion 1.0,
// holistic across European Union, United States, United Kingdom, China. Each analyst assessment is a
// reviewed `assessed_level` claim; a component with no reviewed level is pending,
// and any pending component makes its axis index pending (never a silent 0).

commitment FRONTIER_AI_GOVERNANCE {
  title "Frontier AI governance";
  subjects { "frontier-ai-governance" };
  evaluation_window [2025-01-01, 2026-07-21];
  evidence_policy open_world;
  unknown_policy propagate;
  action_identity strict_separate by id;

  measure knowledge_concentration {
    // Operational control
    component operational_control weight 0.2 {
      // Public institutions routinely direct frontier-model training, release,
      // deployment, and access decisions across the selected jurisdictions.
      anchor 0 when exists(claims where subject_ref == "operational-control" and object == 0);
      // Public operational control is broad across the selected jurisdictions and non-
      // public provider discretion is limited to narrow implementation choices.
      anchor 1 when exists(claims where subject_ref == "operational-control" and object == 1);
      // Control is mixed across jurisdictions or lifecycle stages, with meaningful
      // public direction alongside substantial provider discretion.
      anchor 2 when exists(claims where subject_ref == "operational-control" and object == 2);
      // Providers make most training, release, deployment, and access decisions; public
      // intervention is episodic, constraining, or post hoc rather than operational.
      anchor 3 when exists(claims where subject_ref == "operational-control" and object == 3);
      // Near-exclusive non-public control of training, release, deployment, and access
      // is demonstrated across the full selected scope, with no routine public ability
      // to direct lifecycle decisions.
      anchor 4 when exists(claims where subject_ref == "operational-control" and object == 4);
    }
    // Critical-resource control
    component critical_resource_control weight 0.2 {
      // Public institutions control or have guaranteed access to the compute, chips,
      // model weights, training data, and infrastructure required for frontier-model
      // development across the selected jurisdictions.
      anchor 0 when exists(claims where subject_ref == "critical-resource-control" and object == 0);
      // Broad public provision or mandated access substantially offsets dependence on
      // non-public critical resources across the selected jurisdictions.
      anchor 1 when exists(claims where subject_ref == "critical-resource-control" and object == 1);
      // Resource control is mixed, with viable public or diversified alternatives
      // alongside material non-public bottlenecks.
      anchor 2 when exists(claims where subject_ref == "critical-resource-control" and object == 2);
      // Most frontier-relevant compute, weights, training assets, or infrastructure are
      // non-public and viable public alternatives are limited.
      anchor 3 when exists(claims where subject_ref == "critical-resource-control" and object == 3);
      // A narrow non-public group controls indispensable frontier-model resources
      // across the selected scope and no viable public substitute or guaranteed access
      // exists.
      anchor 4 when exists(claims where subject_ref == "critical-resource-control" and object == 4);
    }
    // Information asymmetry
    component information_asymmetry weight 0.2 {
      // Public institutions receive complete, timely, and verifiable information about
      // training, testing, capabilities, safeguards, incidents, and deployment across
      // the selected jurisdictions.
      anchor 0 when exists(claims where subject_ref == "information-asymmetry" and object == 0);
      // Broad mandatory technical access exists across the selected jurisdictions, with
      // only minor timing or detail gaps.
      anchor 1 when exists(claims where subject_ref == "information-asymmetry" and object == 1);
      // Meaningful mandatory access exists in some jurisdictions or information
      // categories, but important lifecycle or coverage gaps remain.
      anchor 2 when exists(claims where subject_ref == "information-asymmetry" and object == 2);
      // Public institutions depend heavily on selective provider disclosure and
      // technical-information obligations are fragmented across jurisdictions or model
      // categories.
      anchor 3 when exists(claims where subject_ref == "information-asymmetry" and object == 3);
      // Essential technical and operational information is inaccessible to public
      // institutions across the selected scope and no compulsory access route exists.
      anchor 4 when exists(claims where subject_ref == "information-asymmetry" and object == 4);
    }
    // Evaluation dependence
    component evaluation_dependence weight 0.2 {
      // Public institutions can independently test complete frontier systems through
      // compulsory, timely access to relevant model variants, safeguards, tools, and
      // technical information.
      anchor 0 when exists(claims where subject_ref == "evaluation-dependence" and object == 0);
      // Independent public evaluation access is broad across the selected
      // jurisdictions, with only occasional dependence on provider assistance.
      anchor 1 when exists(claims where subject_ref == "evaluation-dependence" and object == 1);
      // Substantial public evaluation capacity exists, but model access, system
      // coverage, timing, or access to internals is inconsistent.
      anchor 2 when exists(claims where subject_ref == "evaluation-dependence" and object == 2);
      // Public evaluation depends mainly on provider-granted access, configurations,
      // technical assistance, or information, subject to limited statutory exceptions.
      anchor 3 when exists(claims where subject_ref == "evaluation-dependence" and object == 3);
      // Public institutions cannot independently evaluate frontier systems and must
      // rely wholly on provider claims, tools, and discretionary access.
      anchor 4 when exists(claims where subject_ref == "evaluation-dependence" and object == 4);
    }
    // Expertise concentration
    component expertise_concentration weight 0.2 {
      // Public frontier-model expertise equals or exceeds non-public capacity across
      // the selected jurisdictions and covers all required technical functions.
      anchor 0 when exists(claims where subject_ref == "expertise-concentration" and object == 0);
      // Durable public teams cover nearly all frontier-governance needs, with only
      // minor hiring, retention, or specialization gaps.
      anchor 1 when exists(claims where subject_ref == "expertise-concentration" and object == 1);
      // Meaningful public expertise exists, but material hiring, retention, scale, or
      // specialized-capability gaps persist.
      anchor 2 when exists(claims where subject_ref == "expertise-concentration" and object == 2);
      // Leading expertise is concentrated in frontier laboratories and contractors,
      // while public capacity is limited or uneven across the selected jurisdictions.
      anchor 3 when exists(claims where subject_ref == "expertise-concentration" and object == 3);
      // Essential frontier-model expertise is almost entirely outside public
      // institutions across the selected scope, creating near-total dependence on non-
      // public actors.
      anchor 4 when exists(claims where subject_ref == "expertise-concentration" and object == 4);
    }
    aggregate weighted_ordinal_percent scale 4;
  }

  measure public_authority {
    // Binding legal mandate
    component binding_legal_mandate weight 0.2 {
      // No selected jurisdiction has a binding mandate directed at general-purpose or
      // frontier-model governance.
      anchor 0 when exists(claims where subject_ref == "binding-legal-mandate" and object == 0);
      // Authority rests mainly on general law, voluntary commitments, guidance, or ad
      // hoc arrangements rather than binding frontier-model duties.
      anchor 1 when exists(claims where subject_ref == "binding-legal-mandate" and object == 1);
      // Binding duties exist in limited jurisdictions, for limited model categories, or
      // for limited lifecycle stages.
      anchor 2 when exists(claims where subject_ref == "binding-legal-mandate" and object == 2);
      // Binding frontier-model duties cover most of the selected field, but material
      // jurisdictional gaps, exemptions, or implementation fragmentation remain.
      anchor 3 when exists(claims where subject_ref == "binding-legal-mandate" and object == 3);
      // Comprehensive and operational binding mandates cover general-purpose and
      // frontier models throughout their lifecycle in all four selected jurisdictions.
      anchor 4 when exists(claims where subject_ref == "binding-legal-mandate" and object == 4);
    }
    // Compulsory information access
    component compulsory_information_access weight 0.2 {
      // Public institutions have no power to compel frontier-model technical, training,
      // evaluation, incident, or deployment information.
      anchor 0 when exists(claims where subject_ref == "compulsory-information-access" and object == 0);
      // Compulsory access is narrow, ad hoc, or limited to post-incident investigation
      // under general powers.
      anchor 1 when exists(claims where subject_ref == "compulsory-information-access" and object == 1);
      // Compulsory access exists in limited jurisdictions or information categories,
      // with major lifecycle or territorial gaps.
      anchor 2 when exists(claims where subject_ref == "compulsory-information-access" and object == 2);
      // Broad compulsory powers operate across most of the selected field, but material
      // scope, timing, or coordination gaps remain.
      anchor 3 when exists(claims where subject_ref == "compulsory-information-access" and object == 3);
      // Public institutions have timely, comprehensive, and enforceable access to
      // relevant frontier-model information across all selected jurisdictions.
      anchor 4 when exists(claims where subject_ref == "compulsory-information-access" and object == 4);
    }
    // Independent evaluation power
    component independent_evaluation_power weight 0.2 {
      // Public institutions have neither legal power nor technical capacity to evaluate
      // frontier models independently.
      anchor 0 when exists(claims where subject_ref == "independent-evaluation-power" and object == 0);
      // Public technical capacity or voluntary testing arrangements exist, but
      // institutions cannot compel access or evaluation.
      anchor 1 when exists(claims where subject_ref == "independent-evaluation-power" and object == 1);
      // Legal evaluation power or capable public institutions exist in part of the
      // selected scope, with substantial access or coverage limitations.
      anchor 2 when exists(claims where subject_ref == "independent-evaluation-power" and object == 2);
      // Broad independent evaluation power covers most of the selected field, but
      // jurisdictional, lifecycle, or technical fragmentation remains.
      anchor 3 when exists(claims where subject_ref == "independent-evaluation-power" and object == 3);
      // Routine, compulsory, full-access independent evaluation is legally and
      // operationally available throughout the model lifecycle in all selected
      // jurisdictions.
      anchor 4 when exists(claims where subject_ref == "independent-evaluation-power" and object == 4);
    }
    // Corrective and enforcement power
    component corrective_and_enforcement_power weight 0.2 {
      // Public institutions have no power to require frontier-model corrections or
      // impose sanctions.
      anchor 0 when exists(claims where subject_ref == "corrective-and-enforcement-power" and object == 0);
      // Institutions rely on indirect general-law remedies, advice, or voluntary
      // requests rather than dedicated binding powers.
      anchor 1 when exists(claims where subject_ref == "corrective-and-enforcement-power" and object == 1);
      // Binding corrective or sanctioning powers exist in limited jurisdictions or
      // scope, or are not yet fully operational.
      anchor 2 when exists(claims where subject_ref == "corrective-and-enforcement-power" and object == 2);
      // Substantial mitigation, withdrawal, recall, suspension, or penalty powers cover
      // most of the selected field, with residual fragmentation.
      anchor 3 when exists(claims where subject_ref == "corrective-and-enforcement-power" and object == 3);
      // Comprehensive and operational corrective and enforcement powers cover all
      // relevant lifecycle stages and all four selected jurisdictions.
      anchor 4 when exists(claims where subject_ref == "corrective-and-enforcement-power" and object == 4);
    }
    // Coverage and coordination
    component coverage_and_coordination weight 0.2 {
      // No selected jurisdiction has defined institutional coverage or coordination for
      // general-purpose or frontier-model governance.
      anchor 0 when exists(claims where subject_ref == "coverage-and-coordination" and object == 0);
      // Coverage consists mainly of isolated initiatives, advisory bodies, or voluntary
      // forums without defined operational roles.
      anchor 1 when exists(claims where subject_ref == "coverage-and-coordination" and object == 1);
      // Relevant institutions exist across parts of the selected scope, but material
      // gaps, overlaps, or non-binding coordination remain.
      anchor 2 when exists(claims where subject_ref == "coverage-and-coordination" and object == 2);
      // Formal coverage and coordination span most jurisdictions and lifecycle stages,
      // with residual fragmentation or unclear responsibility.
      anchor 3 when exists(claims where subject_ref == "coverage-and-coordination" and object == 3);
      // Clear, operational lifecycle and cross-jurisdiction coordination covers the
      // full selected field with defined responsibilities and effective information
      // sharing.
      anchor 4 when exists(claims where subject_ref == "coverage-and-coordination" and object == 4);
    }
    aggregate weighted_ordinal_percent scale 4;
  }

  // The governance gap: knowledge concentration minus public authority. Pending
  // on either side (a real state of this live assessment) makes the gap pending.
  let gap: Int = subtract(knowledge_concentration, public_authority);

  score {
    result "not_applicable" priority 0 when public_authority__public id measurement;
    otherwise not_applicable "This field's outcome is a set of graded measures; see the receipt measures.";
  }
}
