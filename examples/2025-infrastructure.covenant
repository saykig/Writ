language covenant "0.1"
package g7.kananaskis_2025.infrastructure version "1.0.0";

commitment QUALITY_INFRASTRUCTURE_PARTNERSHIPS {
  title "Advance quality infrastructure through direct partner cooperation";
  subjects G7Members;
  evaluation_window [2025-06-18, 2026-06-01];
  evidence_policy open_world;
  unknown_policy propagate;

  let direct_partner_actions: Int = count_distinct(actions where
    partner_classes nonempty and attribution in {unilateral, joint, implementing_partner}
    distinct_by underlying_instrument_id);
  let domestic_only_actions: Int = count(actions where jurisdiction_scope == domestic_only);

  score {
    result "+1" priority 10 when direct_partner_actions >= 3 id full;
    result "0" priority 10 when direct_partner_actions between {1, 2} id partial;
    result "-1" priority 10 when direct_partner_actions == 0 id none;
    otherwise unresolved "Direct partner attribution cannot be established.";
  }

  assert monotonic over direct_partner_actions in 0..10;
}
