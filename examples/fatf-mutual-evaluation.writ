language writ "0.1"
package fatf.mutual_evaluation version "1.0.0";

// FATF Mutual Evaluations (AML/CFT), ported to Writ — the third methodology.
//
// The Financial Action Task Force rates each assessed country on two axes,
// published in full per country in the Consolidated Assessment Ratings table:
//
//   - Technical compliance: each of the 40 Recommendations is rated
//       Compliant (C) / Largely Compliant (LC) / Partially Compliant (PC) /
//       Non-Compliant (NC)  (with Not Applicable where a Recommendation does
//       not apply). The boundary this methodology exists to surface is
//       **"largely" vs "partially" compliant** — a documented analyst judgment,
//       the FATF analog of the pilot's "up to four".
//   - Effectiveness: each of the 11 Immediate Outcomes is rated
//       High / Substantial / Moderate / Low. The load-bearing word is
//       **"substantial" vs "moderate"**.
//
// What Writ reproduces here is not the ratings themselves (those are FATF's
// published record, carried in as evidence) but the DERIVED, published outcome
// FATF computes from them: the country's **follow-up stream** (regular vs
// enhanced), assigned mechanically at the adoption of the Mutual Evaluation
// Report. Reproducing that placement from the published ratings is a check
// against a record we did not author.
//
// ─────────────────────────────────────────────────────────────────────────────
// SOURCE-GATED (scaffold). The enhanced-follow-up trigger constants below
// (the 8 / 9 / 6 thresholds and the core-Recommendation set) are transcribed
// from recollection of the FATF Procedures and MUST be verified against the
// primary source — "Procedures for the FATF Fourth Round of AML/CFT Mutual
// Evaluations" — before any reproduction result is claimed. The per-country
// ratings and the actual assigned follow-up streams are likewise sourced from
// the FATF Consolidated Assessment Ratings table when it is reachable. Until
// then, no cell of `benchmark/fatf-mutual-evaluation/` contains a real rating,
// and the reproduction test is held pending (see fatf-reproduction.test.ts).
// See docs/NEXT-METHODOLOGIES.md and the corpus README for exactly what remains.
// ─────────────────────────────────────────────────────────────────────────────

commitment FATF_MUTUAL_EVALUATION {
  title "FATF Mutual Evaluation follow-up stream";
  subjects { "fatf-assessed-country" };
  evaluation_window [2014-01-01, 2026-03-23];
  evidence_policy open_world;
  unknown_policy propagate;

  // Each rating is one reviewed claim: a technical-compliance claim carries
  // claim_type "technical_compliance", subject_ref "R.<n>", object one of
  // {C, LC, PC, NC, NA}; an effectiveness claim carries claim_type
  // "effectiveness", subject_ref "IO.<n>", object one of {High, Substantial,
  // Moderate, Low}. Each claim is its own record (no identity dedup — the raw
  // membership count is what the follow-up rule reads).
  action_identity strict_separate by id;

  // ── Technical compliance roll-up ──────────────────────────────────────────
  // Number of Recommendations rated Partially or Non-Compliant.
  let tc_deficient: Int =
    count(claims where claim_type == "technical_compliance" and object in {"NC", "PC"});

  // Whether any *core* Recommendation is PC/NC. Core set per the FATF Procedures
  // (R.3 money-laundering offence, R.5 terrorist-financing offence, R.6 targeted
  // financial sanctions — terrorism, R.10 customer due diligence, R.11 record
  // keeping, R.20 reporting of suspicious transactions). SOURCE-GATED: confirm
  // the exact core set against the Procedures before claiming reproduction.
  let tc_core_deficient: Truth =
    exists(claims where claim_type == "technical_compliance"
      and object in {"NC", "PC"}
      and subject_ref in {"R.3", "R.5", "R.6", "R.10", "R.11", "R.20"});

  // ── Effectiveness roll-up ─────────────────────────────────────────────────
  // Number of Immediate Outcomes rated Low or Moderate, and rated Low.
  let eff_low_or_moderate: Int =
    count(claims where claim_type == "effectiveness" and object in {"Low", "Moderate"});
  let eff_low: Int =
    count(claims where claim_type == "effectiveness" and object == "Low");

  // ── Follow-up stream ──────────────────────────────────────────────────────
  // Enhanced follow-up is triggered by ANY of the four documented conditions;
  // otherwise the country is placed in regular follow-up. The two branches are
  // exact negations, so the rule partitions the rating space — the analyzer
  // verifies this statically (no gap, no overlap) over the declared domains.
  //
  // The outcome is binary-ordinal and expressed in the three-point score
  // vocabulary the receipt carries: **+1 = regular follow-up** (an adequate
  // system, no trigger met), **-1 = enhanced follow-up** (deficiencies trigger
  // heightened scrutiny). The `regular_followup` / `enhanced_followup` rule ids
  // preserve the semantic names; `0` is unused (there is no middle stream).
  // SOURCE-GATED thresholds: 8 (a), 9 (c), 6 (d) — verify against the Procedures.
  score {
    result "-1" priority 10 when
      tc_deficient >= 8
      or tc_core_deficient
      or eff_low_or_moderate >= 9
      or eff_low >= 6
      id enhanced_followup;
    result "+1" priority 10 when
      tc_deficient < 8
      and not tc_core_deficient
      and eff_low_or_moderate < 9
      and eff_low < 6
      id regular_followup;
    otherwise unresolved "Ratings are insufficient to determine the follow-up stream.";
  }

  // Over the declared count domains (40 Recommendations, 11 Immediate Outcomes),
  // the regular/enhanced split is total and non-overlapping.
  assert exhaustive over
    tc_deficient in 0..40, tc_core_deficient in {true, false},
    eff_low_or_moderate in 0..11, eff_low in 0..11;
  assert non_overlapping over
    tc_deficient in 0..40, tc_core_deficient in {true, false},
    eff_low_or_moderate in 0..11, eff_low in 0..11;
}
