language covenant "0.1"
package g7.kananaskis_2025.ai_sme.resolved version "1.0.0";

commitment AI_SME_ADOPTION {
  title "Sustain investments in AI adoption programs for SMEs";
  summit Kananaskis2025;
  adopted 2025-06-17;
  subjects G7Members;
  evaluation_window [2025-06-18, 2026-06-01];
  evidence_policy open_world;
  unknown_policy propagate;

  parameter counteraction_precedence: Bool = true allowed {true, false};
  action_identity propagate_uncertainty by underlying_instrument_id, program_family_id;

  let strong_count: Int = count_distinct(actions where classification == strong distinct_by underlying_instrument_id);
  let weak_count: Int = count_distinct(actions where classification == weak distinct_by underlying_instrument_id);
  let counter_exists: Truth = exists(actions where classification == counter);

  score {
    result "-1" priority 30 when counteraction_precedence and counter_exists id counter_override;
    result "+1" priority 20 when not counter_exists and strong_count >= 5 id full;
    result "0" priority 20 when not counter_exists and
      ((strong_count between {1, 4}) or (strong_count == 0 and weak_count >= 3)) id partial;
    result "-1" priority 20 when not counter_exists and strong_count == 0 and weak_count <= 2 id none;
    otherwise unresolved "Evidence or action identity is insufficient for a deterministic score.";
  }

  assert exhaustive over strong_count in 0..20, weak_count in 0..20, counter_exists in {true, false};
  assert non_overlapping over strong_count in 0..20, weak_count in 0..20, counter_exists in {true, false};
}
