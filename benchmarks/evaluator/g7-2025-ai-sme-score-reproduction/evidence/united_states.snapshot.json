  "passages": [
    {
      "id": "passage-united_states-ai-technology-stack-export-eo",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 188,
      "quote": "An Executive Order established the AI Exports Program and coordinates with the Small Business Administration's Office of Investment and Innovation to channel investment into US small businesses developing AI technology.",
      "anchor_hash": "sha256:ccddd5119ef86ae1fbb7bb805dff9635e10aad851aac8144c341204188a8b780",
      "language": "en"
    },
    {
      "id": "passage-united_states-americas-ai-action-plan",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 188,
      "quote": "America's AI Action Plan, a general strategy to accelerate US AI innovation, suggests supporting SME participation in open-source models and encourages SME access to large-scale computing power.",
      "anchor_hash": "sha256:91b5e52edb000018ff24ff5ba9bca4d9e9f1d5954d16a6444ad0fc3af1f9615a",
      "language": "en"
    },
    {
      "id": "passage-united_states-genesis-mission",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 189,
      "quote": "The White House launched the Genesis Mission, an integrated AI platform using Federal scientific datasets, which will help private-sector businesses like SMEs automate research workflows.",
      "anchor_hash": "sha256:d170e344e6ac0645a74669b05a6ae4a29745e8dfe0e79f3e1e025f99e1fb6446",
      "language": "en"
    },
    {
      "id": "passage-united_states-dol-ai-literacy-framework",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 189,
      "quote": "The Department of Labor released an AI Literacy Framework with five content areas and seven delivery principles to guide AI literacy across workforce systems, including SMEs.",
      "anchor_hash": "sha256:8fb32a65478966885f42cb4e532a297670f3c98175509ab65cf5b774114d8761",
      "language": "en"
    },
    {
      "id": "passage-united_states-india-summit-world-bank-fund",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 189,
      "quote": "Michael Kratsios announced sending the US Tech Corps to partner nations and opening a World Bank fund to help countries overcome barriers to adopting AI in SMEs.",
      "anchor_hash": "sha256:4a3bb114c20b5810b0e0e7029ae21c4d70a6b57e993139ccb2d61465051cd4f0",
      "language": "en"
    },
    {
      "id": "passage-united_states-national-policy-framework-ai",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 189,
      "quote": "The National Policy Framework for AI calls for Congress to provide grants, tax incentives and technical assistance to support AI adoption; these measures remain in the recommendation phase.",
      "anchor_hash": "sha256:bfea23e555686163855dbf285c95d909c23e3cc7ab1abc1d5a2ba3857bed56fe",
      "language": "en"
    }
  ],
