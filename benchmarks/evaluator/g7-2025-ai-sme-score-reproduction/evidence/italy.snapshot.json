  ],
  "passages": [
    {
      "id": "passage-italy-congo-mou-startups",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 181,
      "quote": "Minister Urso signed a Memorandum of Understanding with the Republic of Congo to support local startups incorporating AI, helping SMEs reduce barriers to AI.",
      "anchor_hash": "sha256:0c6a2f93a31f13c8bf1ed4059a966d30c3897111b16c9817ab725093f473f147",
      "language": "en"
    },
    {
      "id": "passage-italy-ai-hub-sustainable-development",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 181,
      "quote": "Italy and the UNDP opened the AI Hub for Sustainable Development to strengthen energy-efficient AI infrastructure so that African SMEs may use it to promote economic growth.",
      "anchor_hash": "sha256:f2f7d0078fd83501ff179a1eafe8ce2345c014383b84de49a78881e528360c66",
      "language": "en"
    },
    {
      "id": "passage-italy-ai4industry-virkkunen-meeting",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 182,
      "quote": "Minister Urso met Executive Vice-President Virkkunen, highlighting the AI4Industry foundation in Turin and reaffirming Italy's commitment to SME AI adoption.",
      "anchor_hash": "sha256:0b433287c5092c13461977010ca91484915d90cb97b7f81c3ceaa5a6a30fa497",
      "language": "en"
    },
    {
      "id": "passage-italy-smau-2025-innovation-award",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 182,
      "quote": "MIMIT announced recipients of the SMAU 2025 Innovation Award, with the Turin tech hub CTE Next recognized for leveraging AI to optimize vehicle mobility.",
      "anchor_hash": "sha256:93e841f3153716e9299759f20aeea95a00f0b5f3e8d649b0afde97622c176c21",
      "language": "en"
    },
    {
      "id": "passage-italy-ai-match-pilot",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 182,
      "quote": "AI4I, the Chamber of Commerce of Turin and Piemonte Innova launched AI Match, a national pilot making AI accessible to SMEs with training, matching and voucher-based financial support.",
      "anchor_hash": "sha256:48100d66a5243f2faa69ff79a4fb0a4c7729a3e2303d508818e0fd7bba98f33b",
      "language": "en"
    },
    {
      "id": "passage-italy-lobito-corridor-dialogue",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 182,
      "quote": "Prime Minister Meloni discussed building AI infrastructure value chains throughout the Lobito corridor at the African Union-European Union Business Forum.",
      "anchor_hash": "sha256:3034f84a070d9c35e0602b1c2c2cddae4f662f5be22b67bfe11972d10fca5449",
      "language": "en"
    },
    {
      "id": "passage-italy-it4lia-ai-factory",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 182,
      "quote": "The operational opening of the IT4LIA AI Factory, one of Europe's first AI-dedicated factories, promotes AI adoption in SMEs through better access to compute and digital infrastructure.",
      "anchor_hash": "sha256:afce8b41b63e69c235ff04deff0f775c19bb5411b8c329e89f77bdc186220fb9",
      "language": "en"
    },
    {
      "id": "passage-italy-italy-canada-jag-declaration",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 183,
      "quote": "A declaration between Italy and Canada is developing a collaborative project fostering the adoption of AI solutions in SMEs, to be presented at a 2026 workshop hosted in Italy.",
      "anchor_hash": "sha256:a489fa62a56ecbaf48a9c0e303fe693af575fb5559cb6b615ff82c9267b95790",
      "language": "en"
    },
    {
      "id": "passage-italy-nairobi-harmonic-africa",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 183,
      "quote": "At the Nairobi AI Forum, Italy, Kenya and the UNDP launched the Harmonic Africa Startup Acceleration Program with a EUR50 million endowment and an Italian incubator to fund African AI startups.",
      "anchor_hash": "sha256:a03aa27e06ceb5fde92264a5416d6fd5176314ff2991c688a79e547021f46f71",
      "language": "en"
    },
    {
      "id": "passage-italy-innoconnect-greece-italy",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 183,
      "quote": "Interreg reviewed the SME-centred InnoConnect project, an AI-based matchmaking platform pairing SMEs with investors to provide access to funding and partnerships.",
      "anchor_hash": "sha256:cd8f47e965e37ad660dceba69bc8d19ffa50e6a6e1275b3b31ffdbae8450ad37",
      "language": "en"
    },
    {
      "id": "passage-italy-ai4i-accenture-partnership",
      "document_version_id": "dv-g7-2025-kananaskis-ai-sme-ch4",
      "anchor_type": "pdf_text",
      "page_number": 183,
      "quote": "AI4I announced a strategic partnership with Accenture to accelerate AI adoption across Italian SMEs, offloading document management, inventory forecasting and demand prediction.",
      "anchor_hash": "sha256:30046a3ee0d3f23330ab61d3a9626f6fc8cfa063e39331fc116a4f8ea3146f6d",
      "language": "en"
    }
  ],
