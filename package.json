{
  "name": "writ-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "internal/verification/writ"
  ],
  "scripts": {
    "prebuild": "bun run --filter '@writ/provenance' build",
    "build": "bun run --filter '*' build",
    "pretest": "bun run --filter '@writ/provenance' build",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "pretypecheck": "bun run --filter '@writ/provenance' build",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "data:export": "bun run --filter '@writ/data-bundle' export",
    "data:check": "bun run --filter '@writ/data-bundle' check",
    "preverify:writ": "bun run --filter '@writ/provenance' build",
    "verify:writ": "bun internal/verification/writ/src/cli.ts all",
    "preverify:ontology": "bun run --filter '@writ/provenance' build",
    "verify:ontology": "bun internal/verification/writ/src/cli.ts ontology",
    "preverify:interop": "bun run --filter '@writ/provenance' build",
    "verify:interop": "bun internal/verification/writ/src/cli.ts interoperability",
    "preverify:provenance": "bun run --filter '@writ/provenance' build",
    "verify:provenance": "bun internal/verification/writ/src/cli.ts provenance",
    "preverify:integrity": "bun run --filter '@writ/provenance' build",
    "verify:integrity": "bun internal/verification/writ/src/cli.ts integrity",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
