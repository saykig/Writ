{
  "name": "covenant-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "reference-core"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "conformance": "bun test packages/conformance",
    "conformance:reference": "bun run --filter '@covenant/reference-core' test",
    "dev": "bun run --filter '@covenant/api' --filter '@covenant/studio' dev",
    "studio": "bun run --filter '@covenant/studio' dev",
    "db:up": "docker compose up -d postgres minio",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
