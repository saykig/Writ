record nist_national_measurement_standards_mandate : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "NIST national-measurement-standards mandate";
  subjects { subject nist type institution role "responsible institution"; };
  assertion assigns "The current official OLRC text of 15 U.S.C. § 272(b)(2), containing laws in effect on August 7, 2026, assigns NIST responsibility to develop, maintain and retain custody of the national standards of measurement and to provide the means and methods for making measurements consistent with those standards.";
  topics { measurement_science };
  scope { jurisdictions { "United States" }; institutional_scope { nist }; temporal_scope {} conditions { "Responsibility as codified in the stored current OLRC text of 15 U.S.C. § 272(b)(2), containing laws in effect on August 7, 2026" }; }
  evidence {
    support us_code.title15_usc_272 document_version us_code.title15_usc_272.v2026_08_07 passage us_code.title15_usc_272.b_2 locator "15 U.S.C. § 272(b)(2)" quote "to develop, maintain, and retain custody of the national standards of measurement, and provide the means and methods for making measurements consistent with those standards;" passage_hash "sha256:7b5d22a2d42aa1f5b42b3d1b32e4a2fca3c6640db6467adb2dd2cb3a48e8a019" document_hash "sha256:456fb61742da7ee5e996116af634ca569955a3319429027aed083903d41bcb7d" basis direct;
  }
  uncertainty { item unknown "This record establishes the responsibility in the stored current OLRC text containing laws in effect on August 7, 2026. It does not establish currency after that date or general regulatory authority over industry, private standards bodies or every use of measurement standards."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; }
  review_state approved;
  institutional {
    institution_id nist;
    fact_type mandate;
    mandate { status established; text "Develop, maintain and retain custody of national measurement standards and provide consistent measurement means and methods."; authority_source_ids { us_code.title15_usc_272 }; evidence_refs { us_code.title15_usc_272.b_2 }; }
  }
}

record nist_nvlap_lab_decision_right : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "NVLAP laboratory-accreditation decision right";
  subjects { subject nist type institution role "accreditation decision maker"; };
  assertion authorizes "NIST, through the National Voluntary Laboratory Accreditation Program, determines whether a testing or calibration laboratory has demonstrated the competence required for accreditation within a specified scope.";
  topics { laboratory_accreditation };
  scope { jurisdictions { "United States" }; institutional_scope { nist }; temporal_scope {} conditions { "Laboratory accreditation through NVLAP within a specified scope" }; }
  evidence {
    support ecfr.title15_cfr_part_285 document_version ecfr.title15_cfr_part_285.v2026_08_01 passage ecfr.title15_cfr_part_285.section_285_9_a locator "15 CFR § 285.9(a)" quote "The Chief of NVLAP is responsible for all NVLAP accreditation actions, including granting, denying, renewing, suspending, and revoking any NVLAP accreditation." passage_hash "sha256:bad7706f4b4a2bed7afe210bf35e9f890d9960cf30f6477c4fe97fa41917f2c7" document_hash "sha256:b4c06f92e650ea7762d3687419eeb51fc9a8ec506f199e1a39d15772de3e2919" basis direct;
    support nist.handbook_150 document_version nist.handbook_150.v2020_update_1 passage nist.handbook_150.competence locator "NIST Handbook 150:2020, clause 1.3.5" quote "NVLAP accreditation is based on the evaluation of a laboratory’s management and technical competence for conducting specific tests or calibrations. Accreditation is granted only after thorough evaluation of an applicant has demonstrated that all NVLAP requirements have been fulfilled." passage_hash "sha256:f6263b3ae31de22e2ba0f486d2092bb154179287ad0a38001a0cf8e3ef054700" document_hash "sha256:7105b9f201a580599b1871fcb7dd9cb5c09b0dcc46bb7e9bd654a960cae65f7e" basis direct;
    support nist.handbook_150 document_version nist.handbook_150.v2020_update_1 passage nist.handbook_150.accreditation_decision locator "NIST Handbook 150:2020, clause 3.5.3" quote "Based on this evaluation, NVLAP makes the decision whether or not to accredit the laboratory." passage_hash "sha256:cc833bd19e3e1ba753395046a518a87828e00834e22bb72e2e7146dfa79e6ba1" document_hash "sha256:7105b9f201a580599b1871fcb7dd9cb5c09b0dcc46bb7e9bd654a960cae65f7e" basis direct;
  }
  uncertainty { item unknown "This decision right is limited to laboratory accreditation through NVLAP. It does not establish general regulatory authority, authority over every laboratory, product certification or authority to make unrelated NIST guidance legally binding."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; }
  review_state approved;
  institutional {
    institution_id nist;
    fact_type decision_right;
    decision_right { status established; text "Determine whether a laboratory has demonstrated competence for NVLAP accreditation within a specified scope."; authority_source_ids { ecfr.title15_cfr_part_285, nist.handbook_150 }; evidence_refs { ecfr.title15_cfr_part_285.section_285_9_a, nist.handbook_150.competence, nist.handbook_150.accreditation_decision }; }
  }
}

