record nist_ai_consortium_capacity : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "NIST AI Consortium partnership capacity";
  subjects { subject nist type institution role "consortium organizer"; };
  assertion observes "NIST maintains an AI research partnership through which external organizations may contribute expertise, products, data or models to work on AI measurement guidelines and standards.";
  topics { artificial_intelligence, research_partnerships };
  scope { jurisdictions { "United States" }; institutional_scope { nist, nist.ai_consortium }; temporal_scope {} conditions { "Participation is open to organizations able to make the stated contributions" }; }
  evidence {
    support nist.ai_consortium document_version nist.ai_consortium.v2026_08_05 passage nist.ai_consortium.partnership locator "NIST AI Consortium, overview" quote "Building upon its long track record of working with the private and public sectors to develop reliable and practical measurement and standards-oriented solutions, NIST has partnered with organizations from industry, academia, and civil society to form a research partnership that supports the development of science-based empirically-backed guidelines and standards for AI measurement that lays the foundation for global AI metrology." passage_hash "sha256:48475fa02e08511ec3f754fd93cb4fee2ddd3d0d5119fcc1a14fb2bfcef52f85" document_hash "sha256:9673a9ebb47ccf7804be898dff2c8c6238e42f508da762b06d11ba06f7a7bfb0" basis direct;
    support nist.ai_consortium document_version nist.ai_consortium.v2026_08_05 passage nist.ai_consortium.contributions locator "NIST AI Consortium, membership eligibility" quote "Participation in the consortium is open to all interested organizations that can contribute their expertise, products, data, and/or models to the activities of the consortium." passage_hash "sha256:40e110c4ebe66ab610c0f08ac4e929393cf1623b2193489b32e99cc520c24e7c" document_hash "sha256:9673a9ebb47ccf7804be898dff2c8c6238e42f508da762b06d11ba06f7a7bfb0" basis direct;
    support nist.ai_consortium document_version nist.ai_consortium.v2026_08_05 passage nist.ai_consortium.organization_count locator "NIST AI Consortium, current membership statement" quote "The Consortium brings together more than 280 organizations to develop science-based and empirically backed guidelines and standards for AI measurement." passage_hash "sha256:64f3a826db55b7d57e6e923f69f110d75162e710213bcfb81dc527bf2e6a558f" document_hash "sha256:9673a9ebb47ccf7804be898dff2c8c6238e42f508da762b06d11ba06f7a7bfb0" basis direct;
