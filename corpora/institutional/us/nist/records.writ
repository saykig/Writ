record nist_mission : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "NIST source-reported mission";
  subjects {
    subject nist type institution role "subject";
  };
  assertion states "NIST states that its mission is to promote U.S. innovation and industrial competitiveness by advancing measurement science, standards and technology in ways that enhance economic security and quality of life.";
  topics {};
  scope {
    jurisdictions { "United States" };
    institutional_scope { nist };
    temporal_scope {}
    conditions {};
  }
  evidence {
    support nist.about document_version nist.about.v2022_01_11 passage nist.about.mission locator "About NIST, Mission" quote "To promote U.S. innovation and industrial competitiveness by advancing measurement science, standards, and technology in ways that enhance economic security and improve our quality of life." passage_hash "sha256:b7c73bafbedd9701baee1cadf74dc7668b215f3d6f5d19d6b6d51a179120c219" document_hash "sha256:a1a85280232b9e49eed4f5e26dfca894cd76eefb00ba964ce05a5bf1e36970f2" basis direct;
  }
  uncertainty { item unknown "This is NIST's source-reported mission. The passage does not independently establish statutory mandate, demonstrated performance, staffing, funding or operational capacity."; }
  provenance { created_by "Claude Code implementation of approved human review"; created_at 2026-08-04; }
  review_state approved;
  institutional {
    institution_id nist;
    fact_type mission;
    mission {
      text "NIST states that its mission is to promote U.S. innovation and industrial competitiveness by advancing measurement science, standards and technology in ways that enhance economic security and quality of life.";
      source_ids { nist.about };
      evidence_refs { nist.about.mission };
    }
  }
}

