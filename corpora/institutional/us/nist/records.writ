record nist_ai_standards_development_function : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "NIST AI standards-development function";
  subjects {
    subject nist.ai_standards_guidelines_group type organizational_unit role "subject";
  };
  assertion performs "The NIST AI Standards and Guidelines Group leads NIST's participation in the development of voluntary consensus standards, including international standards, concerning AI.";
  topics { artificial_intelligence };
  scope {
    jurisdictions { "United States" };
    institutional_scope { nist.ai_standards_guidelines_group };
    temporal_scope {}
    conditions { "Artificial intelligence standards" };
  }
  evidence {
    support nist.ai_standards_group document_version nist.ai_standards_group.v2026_08_03 passage nist.ai_standards_group.standards locator "AI Standards and Guidelines Group, overview paragraph 2" quote "In addition to developing its own publications, the Group leads NIST's participation in the development of voluntary consensus standards, including international standards, that promote innovation and trustworthiness in systems and organizations that use AI." passage_hash "sha256:ec5b9883154946b69ee3623b9e7394501ced98354288e4167a2eedf4c31609b8" document_hash "sha256:770642cfb32c44bbba3c64daa23e3d883c8f6a547038ac11ebcdfb8f2c629e96" basis direct;
  }
  uncertainty { item unknown "The passage establishes a standards-development function and a coordinating role in NIST's participation. It does not establish statutory mandate, authority over external standards bodies, binding regulatory power or operational capacity."; }
  provenance { created_by "OpenAI Codex automated draft"; created_at 2026-08-03; }
  review_state approved;
  institutional {
    institution_id nist.ai_standards_guidelines_group;
    fact_type function;
    function standards_development;
  }
}

record nist_ai_technical_guidance_function : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
