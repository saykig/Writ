record nist_identity : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "NIST identity";
  subjects {
    subject nist type institution role "subject";
  };
  assertion defines "NIST is the National Institute of Standards and Technology.";
  topics {};
  scope {
    jurisdictions { "United States" };
    institutional_scope { nist };
    temporal_scope {}
    conditions {};
  }
  evidence {
    support nist.about document_version nist.about.v2022_01_11 passage nist.about.identity locator "About NIST, opening paragraph" quote "The National Institute of Standards and Technology (NIST) was founded in 1901 and is now part of the U.S. Department of Commerce." passage_hash "sha256:4cc104fbe6573c0c72f80cf978e68e9661374d64bd67c855a571edb58ac65277" document_hash "sha256:a1a85280232b9e49eed4f5e26dfca894cd76eefb00ba964ce05a5bf1e36970f2" basis direct;
  }
