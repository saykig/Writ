    support nist.ai_standards_group document_version nist.ai_standards_group.v2026_08_03 passage nist.ai_standards_group.guidance locator "AI Standards and Guidelines Group, overview paragraph 1" quote "The Artificial Intelligence (AI) Standards and Guidelines Group develops technical resources and guidelines that help organizations to develop, deploy, and use AI with confidence, enabling U.S. industry to position itself at the forefront of technology development and AI governance." passage_hash "sha256:7a9c75b43200b400de56a5c983cc3c13c2127122e33a86ad8169548ef405f903" document_hash "sha256:770642cfb32c44bbba3c64daa23e3d883c8f6a547038ac11ebcdfb8f2c629e96" basis direct;
