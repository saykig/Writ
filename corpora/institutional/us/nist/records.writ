record nist_aml_facility_capacity : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "Advanced Measurement Laboratory facility capacity";
  subjects { subject nist type institution role "facility operator"; };
  assertion observes "NIST maintains the Advanced Measurement Laboratory complex with specialized environmental controls, underground metrology laboratories, physical-science laboratories and cleanroom infrastructure for high-precision measurement work.";
  topics { measurement_science, research_infrastructure };
  scope { jurisdictions { "United States" }; institutional_scope { nist, nist.advanced_measurement_laboratory }; temporal_scope {} conditions {}; }
  evidence {
    support nist.advanced_measurement_laboratory document_version nist.advanced_measurement_laboratory.v2026_08_05 passage nist.aml.features locator "About the Advanced Measurement Laboratory Complex, facility description" quote "The CNST is located within the NIST Advanced Measurement Laboratory Complex, one of the largest and most technologically advanced research facilities in the world. The complex offers laboratories with electromagnetic shielding, vibration isolation, and superior environmental control of temperature, humidity, and air quality. These laboratories allow NIST to provide the sophisticated measurements and standards needed by U.S. industry and the scientific community for key 21st century technologies such as nanotechnology, semiconductors, biotechnology, advanced materials, quantum computing, and advanced manufacturing. The $235 million, 49,843 square meter (536,507 square foot) Advanced Measurement Laboratory (AML) Complex features five separate wings, each with one scientific instrumentation level. Two metrology wings (buildings 218 and 219) are located underground, two physical sciences wings (buildings 216/CNST and 217) and a cleanroom wing (building 215/NanoFab) are located above ground." passage_hash "sha256:ddedb6b29adcf4c3a3e31c2c73d26c43bb1219ac645003b8b8e837c346fcc1f3" document_hash "sha256:f928e083da64fc2bf6ae582adbdb2021f62b8b9f0349f80601cecfb6bcb8e101" basis direct;
  }
  uncertainty { item unknown "The record establishes the facility’s physical design and intended technical capabilities. It does not establish current utilization, equipment uptime, maintenance condition or full operational availability."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; }
  review_state approved;
  institutional {
    institution_id nist; fact_type operational_capacity;
    operational_capacity { status active; capacity_type facility; capacity_components { electromagnetic_shielding, vibration_isolation, temperature_control, humidity_control, air_quality_control, underground_metrology_wings, physical_science_wings, cleanroom_wing }; evidence_refs { nist.aml.features }; }
  }
}

record nist_nvlap_accred_capacity : institutional {
  corpus us.institutions.nist;
  version "0.2.0";
  title "NVLAP accreditation-system capacity";
  subjects { subject nist type institution role "program operator"; };
  assertion observes "NIST maintains an operational laboratory-accreditation system that processes applications, assesses laboratory competence, addresses nonconformities, uses proficiency testing and technical evaluation, and issues accreditation certificates and scopes.";
  topics { laboratory_accreditation };
  scope { jurisdictions { "United States" }; institutional_scope { nist }; temporal_scope {} conditions { "National Voluntary Laboratory Accreditation Program" }; }
  evidence {
    support ecfr.title15_cfr_part_285 document_version ecfr.title15_cfr_part_285.v2026_08_01 passage ecfr.title15_cfr_part_285.section_285_9_d locator "15 CFR § 285.9(d)" quote "When accreditation is granted, NVLAP shall provide to the laboratory a Certificate of Accreditation and a Scope of Accreditation," passage_hash "sha256:0be471d591511a1e3a85e410fb5b0c2e1df5b356a44e0cf18164b26682d81f2e" document_hash "sha256:b4c06f92e650ea7762d3687419eeb51fc9a8ec506f199e1a39d15772de3e2919" basis direct;
    support nist.accreditation document_version nist.accreditation.v2026_08_05 passage nist.accreditation.process locator "NVLAP accreditation, Accreditation process" quote "Accreditation requirements are established in accordance with the U.S. Code of Federal Regulations (CFR, Title 15, Part 285), National Voluntary Laboratory Accreditation Program, and encompass the requirements of ISO/IEC 17025. Accreditation is granted following successful completion of a process which includes submission of an application and payment of fees by the laboratory, an on-site assessment, resolution of any nonconformities identified during the on-site assessment, participation in proficiency testing, and technical evaluation. The accreditation is formalized through issuance of a Certificate of Accreditation and Scope of Accreditation and publicized by announcement in various government and private media." passage_hash "sha256:664bd8173aae58423acaac0b41b6f33f4b236ac5c90e58f75e9040f9989e1c1f" document_hash "sha256:3e1c7a56c31e74b719b8366d655e0b390948125d73b49f7204a4d0d3bc7e83db" basis direct;
  }
  uncertainty { item unknown "This establishes NIST’s operational machinery for laboratory accreditation. It does not duplicate the accreditation decision right, certify products, guarantee laboratory results or establish that NIST itself holds an ISO/IEC 17025 certification."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; }
  review_state approved;
  institutional {
    institution_id nist; fact_type operational_capacity;
    operational_capacity { status active; capacity_type accreditation_system; capacity_components { application_submission, on_site_assessment, nonconformity_resolution, proficiency_testing, technical_evaluation, certificate_and_scope_issuance }; evidence_refs { ecfr.title15_cfr_part_285.section_285_9_d, nist.accreditation.process }; }
  }
}

