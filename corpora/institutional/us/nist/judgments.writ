language writ "0.2"
package us.institutions.nist.judgments version "0.2.0";

// Stage A human review of the six automated draft records and the two Core links
// derived from them. Judgment `status` is the disposition vocabulary
// (proposed | accepted | contested | superseded); it is separate from the
// `review_state` of the record or link each judgment targets. `value` records the
// workflow state the target reached. These are the first human dispositions for
// every target, so none of them supersedes an earlier judgment.

judgment judgment_nist_identity_stage_a {
  target record nist_identity;
  type review_disposition;
  value "approved";
  rationale "Stage A review moves this record from draft to approved as an atomic identity fact. The passage names the institution and nothing more: identity is not mandate, so the mandate, function and operational-capacity placeholders were removed rather than carried forward as unknown payloads.";
  evidence_refs { nist.about.identity };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_organizational_placement_stage_a {
  target record nist_organizational_placement;
  type review_disposition;
  value "approved";
  rationale "Stage A review moves this record from draft to approved as an atomic placement fact. Placement is not decision authority: the passage situates NIST within the Department of Commerce without establishing the Department's powers over it, so no decision-right payload was added.";
  evidence_refs { nist.about.identity };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_measurement_science_function_stage_a {
  target record nist_measurement_science_function;
  type review_disposition;
  value "superseded";
  rationale "Stage A review moves this record from draft to superseded. The cited passage is explicitly labelled a mission statement, so classifying it as a measurement-science function was a misreading. The record is retained as review history rather than deleted, and its replacement is stated by a separate Core supersession link.";
  evidence_refs { nist.about.mission };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_mission_stage_a {
  target record nist_mission;
  type review_disposition;
  value "approved";
  rationale "Stage A review approves this new record, created by the review split, as an atomic mission fact. A mission statement is not a statutory mandate: the record reports what NIST states about itself and establishes no legal authority, demonstrated performance or operational capacity.";
  evidence_refs { nist.about.mission };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_ai_standards_development_function_stage_a {
  target record nist_ai_standards_development_function;
  type review_disposition;
  value "approved";
  rationale "Stage A review moves this record from draft to approved as an atomic function fact. The passage describes an activity the group leads; a function is not automatically a mission, so it stays classified as a function, and a stated activity is not operational capacity, so no capacity payload was added.";
  evidence_refs { nist.ai_standards_group.standards };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_ai_technical_guidance_function_stage_a {
  target record nist_ai_technical_guidance_function;
  type review_disposition;
  value "approved";
  rationale "Stage A review moves this record from draft to approved as an atomic function fact. The passage supports the group's technical-guidance activity but not its formal placement or capacity, so the parent-institution and operational-capacity payloads were removed rather than retained as unknown.";
  evidence_refs { nist.ai_standards_group.guidance };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_department_of_commerce_relationship_stage_a {
  target record_link nist_department_of_commerce_relationship;
  type record_link_disposition;
  value "approved";
  rationale "Stage A review moves this object from draft to approved, and from an institutional record to a Core record link. The link does not duplicate the placement fact: it cites nist_organizational_placement as its supporting record, which remains the authoritative assertion, and the inverse direction is derived rather than stored.";
  evidence_refs { nist.about.identity };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_mission_supersession_link_stage_a {
  target record_link nist_mission_supersedes_nist_measurement_science_function;
  type record_link_disposition;
  value "approved";
  rationale "Stage A review approves this new Core link as approved. It preserves the review history by stating that the approved mission record replaces the earlier misclassified function record, in that direction, without deleting the superseded record or adding a record-level supersession field.";
  evidence_refs { nist.about.mission };
  reviewer "Sara Kim";
  status accepted;
  created_at 2026-08-04;
  family_context institutional;
}

judgment judgment_nist_national_measurement_standards_mandate_stage_b {
  target record nist_national_measurement_standards_mandate; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps the narrow responsibility in the stored 2024 edition of 15 U.S.C. § 272(b)(2) as a mandate. The capture does not prove later statutory currency, and a measurement-standards mandate is not general regulatory authority over industry or private standards bodies. Human approval remains pending.";
  evidence_refs { us_code.title15_usc_272.b_2 }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_nvlap_lab_decision_right_stage_b {
  target record nist_nvlap_lab_decision_right; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps the accreditation determination as a decision right scoped to NVLAP. It is not general regulatory authority, product certification or power to make unrelated guidance binding. Human approval remains pending.";
  evidence_refs { ecfr.title15_cfr_part_285.section_285_9_a, nist.handbook_150.competence, nist.handbook_150.accreditation_decision }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_ai_standards_group_identity_stage_b {
  target record nist_ai_standards_group_identity; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps the named group as an organizational-unit identity. Identity is not a separate legal personality, mandate, independent decision right or operational capacity. Human approval remains pending.";
  evidence_refs { nist.ai_division.groups }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_ai_standards_group_placement_stage_b {
  target record nist_ai_standards_group_placement; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps the group directly to the AI Research, Measurement, and Standards Division, the parent established by the selected passages. Placement is not independent authority, mandate or capacity. Human approval remains pending.";
  evidence_refs { nist.ai_division.itl_placement, nist.ai_division.groups }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_laboratory_network_capacity_stage_b {
  target record nist_laboratory_network_capacity; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps the directly quoted six-laboratory structure and user facilities as active network capacity without naming uncited laboratories. Structure is not proof of equal legal status, resources, utilization, condition or performance. Human approval remains pending.";
  evidence_refs { nist.laboratories.six_labs }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_aml_facility_capacity_stage_b {
  target record nist_aml_facility_capacity; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps the directly documented facility design as capacity. Physical design and intended technical capability do not establish current utilization, maintenance or uptime. Human approval remains pending.";
  evidence_refs { nist.aml.features }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_nvlap_accreditation_capacity_stage_b {
  target record nist_nvlap_accreditation_capacity; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps only the directly quoted accreditation-process machinery as capacity; continuing assessment is omitted as unsupported. The machinery is distinct from the accreditation decision right and does not certify products or guarantee laboratory results. Human approval remains pending.";
  evidence_refs { ecfr.title15_cfr_part_285.section_285_9_d, nist.accreditation.process }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_ai_measurement_capacity_stage_b {
  target record nist_ai_measurement_capacity; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps the dedicated division as organizational-unit capacity and retains only work and groups named in the selected passages. It does not infer technical machinery, guidance, staff, compute, throughput, model access or conclusive legal authority. Human approval remains pending.";
  evidence_refs { nist.ai_division.capacity, nist.ai_division.groups }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}

judgment judgment_nist_ai_consortium_capacity_stage_b {
  target record nist_ai_consortium_capacity; type review_disposition; value "draft";
  rationale "Automated Stage B proposal maps only the partnership, contribution types, AI-measurement work and organization count stated in the selected passages. CRADA, task-group, prototype-evaluation and technology-transfer mechanisms are omitted as unsupported. External resources remain external. Human approval remains pending.";
  evidence_refs { nist.ai_consortium.partnership, nist.ai_consortium.contributions, nist.ai_consortium.organization_count }; reviewer "OpenAI Codex automated proposal"; status proposed; created_at 2026-08-05; family_context institutional;
}
