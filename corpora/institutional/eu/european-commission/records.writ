record european_commission_reasoned_op_function : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European Commission reasoned-opinion function";
  subjects { subject european_commission type institution role "responsible institution"; };
  assertion performs "Where the Commission considers that a Member State has failed to fulfil a Treaty obligation, and after allowing the State to submit observations, Article 258 requires the Commission to deliver a reasoned opinion.";
  topics { union_law, infringement_procedure }; scope { jurisdictions { "European Union" }; institutional_scope { european_commission }; temporal_scope {} conditions { "The Commission considers that a Member State has failed to fulfil a Treaty obligation, after allowing the State to submit observations" }; }
  evidence { support eu.tfeu_article_258 document_version eu.tfeu_article_258.v2026_08_05 passage eu.tfeu_article_258.reasoned_opinion locator "Treaty on the Functioning of the European Union, Article 258, first paragraph" quote "If the Commission considers that a Member State has failed to fulfil an obligation under the Treaties, it shall deliver a reasoned opinion on the matter after giving the State concerned the opportunity to submit its observations." passage_hash "sha256:8f8bf95c1d23c2ff2f3569acaa7c3477b6a2baa19199d1acc81da5c09c590386" document_hash "sha256:ec05de3ed032bc882a25fb54d4ae239cb68fba85ee88a3d3ceb003762ebaf017" basis direct; }
  uncertainty { item unknown "This human-approved function classification preserves the mandatory procedural wording once the stated conditions hold. It remains distinct from the Commission’s separate discretionary right to refer noncompliance to the Court of Justice. Human review approved european_commission_reasoned_op_function as a function in docs/migrations/institutional-stage-b/human-review.yaml."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id european_commission; fact_type function; function treaty_reasoned_opinion_delivery; }
}

record european_commission_cjeu_refer_decision_right : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European Commission CJEU-referral decision right";
  subjects { subject european_commission type institution role "referring institution"; };
  assertion authorizes "Where a Member State does not comply with the Commission’s reasoned opinion within the prescribed period, the Commission may bring the matter before the Court of Justice of the European Union.";
  topics { union_law, infringement_procedure }; scope { jurisdictions { "European Union" }; institutional_scope { european_commission }; temporal_scope {} conditions { "Member State noncompliance with the reasoned opinion within the prescribed period" }; }
  evidence { support eu.tfeu_article_258 document_version eu.tfeu_article_258.v2026_08_05 passage eu.tfeu_article_258.cjeu_referral locator "Treaty on the Functioning of the European Union, Article 258, second paragraph" quote "If the State concerned does not comply with the opinion within the period laid down by the Commission, the latter may bring the matter before the Court of Justice of the European Union." passage_hash "sha256:510c97d209759b32cdf28eef169cfecdd75a1efd2054b29b05b057434c620e75" document_hash "sha256:ec05de3ed032bc882a25fb54d4ae239cb68fba85ee88a3d3ceb003762ebaf017" basis direct; }
  uncertainty { item unknown "This establishes the Commission’s power to initiate the Court stage of the specified infringement procedure. It does not establish the outcome of the case or a general power to adjudicate Treaty violations."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id european_commission; fact_type decision_right; decision_right { status established; text "Bring a matter before the Court of Justice where the Member State does not comply with the reasoned opinion within the prescribed period."; authority_source_ids { eu.tfeu_article_258 }; evidence_refs { eu.tfeu_article_258.cjeu_referral }; } }
}

record european_commission_gp_ai_fine_decision_right : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European Commission GPAI-fine decision right";
  subjects { subject european_commission type institution role "fine-imposing institution"; };
  assertion authorizes "The European Commission may impose fines on providers of general-purpose AI models for specified intentional or negligent infringements of the AI Act.";
  topics { artificial_intelligence, enforcement }; scope { jurisdictions { "European Union" }; institutional_scope { european_commission }; temporal_scope {} conditions { "Grounds, procedures and maximum amounts specified in Article 101 of the AI Act" }; }
  evidence { support eu_ai_act_2024_1689 document_version dv_eu_ai_act_2024_1689 passage passage_eu_ai_act_art_101_1 locator "Regulation (EU) 2024/1689, Article 101(1)" quote "The Commission may impose on providers of general-purpose AI models fines not exceeding 3 % of their annual total worldwide turnover in the preceding financial year or EUR 15 000 000, whichever is higher., when the Commission finds that the provider intentionally or negligently: (a) infringed the relevant provisions of this Regulation; (b) failed to comply with a request for a document or for information pursuant to Article 91, or supplied incorrect, incomplete or misleading information; (c) failed to comply with a measure requested under Article 93; (d) failed to make available to the Commission access to the general-purpose AI model or general-purpose AI model with systemic risk with a view to conducting an evaluation pursuant to Article 92." passage_hash "sha256:2f45f18cffc18e9af1e26d4c38a074ed876eadd4282eac00de5dc53168b330c1" document_hash "sha256:903240828eef48f5d9ae9724aa365b6946d58fb9fb70143506292b3112c4248c" basis direct; }
  uncertainty { item unknown "This power is limited by the grounds, procedures and maximum amounts specified in the AI Act. It does not establish a general Commission power to fine any institution or person for any AI-related conduct."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id european_commission; fact_type decision_right; decision_right { status established; text "Impose fines on GPAI model providers for the specified intentional or negligent Article 101 infringements."; authority_source_ids { eu_ai_act_2024_1689 }; evidence_refs { passage_eu_ai_act_art_101_1 }; } }
}

record eu_ai_office_model_eval_decision_right : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European AI Office model-evaluation decision right";
  subjects { subject eu_ai_office type organizational_unit role "evaluation decision maker"; };
  assertion authorizes "After consulting the European Artificial Intelligence Board, the European AI Office may conduct evaluations of a general-purpose AI model to assess compliance or investigate systemic risks under the conditions specified in the AI Act.";
  topics { artificial_intelligence, model_evaluation }; scope { jurisdictions { "European Union" }; institutional_scope { eu_ai_office }; temporal_scope {} conditions { "After consulting the Board and under Article 92(1) conditions" }; }
  evidence { support eu_ai_act_2024_1689 document_version dv_eu_ai_act_2024_1689 passage passage_eu_ai_act_art_92_1 locator "Regulation (EU) 2024/1689, Article 92(1)" quote "The AI Office, after consulting the Board, may conduct evaluations of the general-purpose AI model concerned: (a) to assess compliance of the provider with obligations under this Regulation, where the information gathered pursuant to Article 91 is insufficient; or (b) to investigate systemic risks at Union level of general-purpose AI models with systemic risk, in particular following a qualified alert from the scientific panel in accordance with Article 90(1), point (a)." passage_hash "sha256:0076c63c049a5c8e15ae46018ffa7b6a5ae549e7147e13d1910db8fe2fce14d1" document_hash "sha256:903240828eef48f5d9ae9724aa365b6946d58fb9fb70143506292b3112c4248c" basis direct; }
  uncertainty { item unknown "This establishes the Office’s power to conduct evaluations. Requests for model access, binding measures and fines remain powers assigned separately by Union law and are not inferred from this record."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id eu_ai_office; fact_type decision_right; decision_right { status established; text "Conduct GPAI model evaluations after consulting the Board under the conditions in AI Act Article 92(1)."; authority_source_ids { eu_ai_act_2024_1689 }; evidence_refs { passage_eu_ai_act_art_92_1 }; } }
}

record european_commission_jrc_infra_capacity : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European Commission JRC infrastructure capacity";
  subjects { subject european_commission type institution role "infrastructure maintainer"; };
  assertion observes "Through the Joint Research Centre, the European Commission maintains physical research infrastructures across nuclear and radiological research, chemistry, biosciences, physical sciences and information technology.";
  topics { research_infrastructure }; scope { jurisdictions { "European Union" }; institutional_scope { european_commission, european_commission.joint_research_centre }; temporal_scope {} conditions { "JRC infrastructure available for opening access to external users as retrieved on 2026-08-05" }; }
  evidence { support ec.jrc_research_infrastructures document_version ec.jrc_research_infrastructures.v2026_08_05 passage ec.jrc_research_infrastructures.inventory locator "Open access to JRC research infrastructures, opening paragraph" quote "The JRC maintains 39 physical research infrastructures suitable for opening access to external users in the nuclear and radiological (Euratom Laboratories) fields, chemistry, biosciences/life sciences, physical sciences and ICT. They are located at our sites in Ispra (Italy), Geel (Belgium), Karlsruhe (Germany) and Petten (The Netherlands). These infrastructures (i.e. laboratories) are fit for experimental work generating data for users’ analyses." passage_hash "sha256:fabc372f9903395ae652330c34cc58330bdc9c2295f19394336252494d733522" document_hash "sha256:25f2cdb0ed3773313b9a5e6d398e02346fef13bc3c80d32149ef39040e6c55c7" basis direct; }
  uncertainty { item unknown "This establishes maintained scientific infrastructure. It does not establish equal staffing, funding, utilization, performance or operational condition across every facility."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id european_commission; fact_type operational_capacity; operational_capacity { status active; capacity_type laboratory_network; capacity_components { nuclear_and_radiological_research, chemistry, biosciences_and_life_sciences, physical_sciences, information_and_communication_technology }; evidence_refs { ec.jrc_research_infrastructures.inventory }; } }
}

record eu_ai_office_org_capacity : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European AI Office organizational capacity";
  subjects { subject eu_ai_office type organizational_unit role "capacity holder"; };
  assertion observes "The European AI Office employs more than 125 staff and has six units and two advisers.";
  topics { artificial_intelligence, organizational_structure }; scope { jurisdictions { "European Union" }; institutional_scope { eu_ai_office }; temporal_scope {} conditions { "Current structure as retrieved on 2026-08-05" }; }
  evidence { support ec.european_ai_office document_version ec.european_ai_office.v2026_08_05 passage ec.european_ai_office.structure locator "European AI Office, The Structure of the AI Office" quote "The AI Office employs more than 125 staff, including technology specialists, administrative assistants, lawyers, policy specialists, and economists. It has 6 units and 2 advisers, reflecting its mandate:" passage_hash "sha256:da0b260472c06e3d3214077dce0bf2a0fbf0a858666ceb016b0a7ae87b6c476b" document_hash "sha256:a110ad6a4dacc47bd1a5b63d955374e3ab4fea4323547657e93f5258036fd2eb" basis direct; }
  uncertainty { item unknown "This establishes the reported staff threshold and generic unit-and-adviser structure. The selected quotation does not name the six units or two advisers and does not establish that every assigned task is fully resourced or successfully performed."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id eu_ai_office; fact_type operational_capacity; operational_capacity { status active; capacity_type organizational_unit; capacity_components { six_units, two_advisers }; evidence_refs { ec.european_ai_office.structure }; } }
}

record eu_ai_office_cooperation_capacity : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European AI Office cooperation capacity";
  subjects { subject eu_ai_office type organizational_unit role "network coordinator"; };
  assertion observes "The European AI Office maintains structured cooperation with Commission departments, Union bodies, Member State authorities, scientific experts, AI developers and other stakeholders.";
  topics { artificial_intelligence, institutional_cooperation }; scope { jurisdictions { "European Union" }; institutional_scope { eu_ai_office, european_commission }; temporal_scope {} conditions {}; }
  evidence {
    support ec.european_ai_office document_version ec.european_ai_office.v2026_08_05 passage ec.european_ai_office.cooperation_platforms locator "European AI Office, Cooperation with institutions, experts and stakeholders" quote "The AI Office collaborates with Member States and the wider expert community through dedicated platforms:" passage_hash "sha256:22502e0d7c84f8b336e555a02ecde308802073548df9bd512f45e8d1cea107ef" document_hash "sha256:a110ad6a4dacc47bd1a5b63d955374e3ab4fea4323547657e93f5258036fd2eb" basis direct;
    support eu.commission_decision_c_2024_1459 document_version eu.commission_decision_c_2024_1459.v2024_02_14 passage eu.commission_decision_c_2024_1459.article_2_3 locator "Commission Decision C/2024/1459, Article 2(3)" quote "In the performance of the tasks referred to in paragraphs 1 and 2 of this Article, the Office shall: (a) work together with stakeholders, in particular experts from the scientific community and AI developers, pursuant to Article 4; (b) collaborate with relevant Directorates-General and services of the Commission pursuant to Article 5; (c) cooperate with all relevant bodies, offices and agencies of the Union, including the European High Performance Computing Joint Undertaking (EuroHPC JU), pursuant to Article 6; (d) cooperate with authorities and bodies of the Member States on behalf of the Commission." passage_hash "sha256:a12c08bc572bfbc6061201e83f170549da691563d0f8fbacfde2fb98d26294a7" document_hash "sha256:d78be7e77403adb1f454035bb39ac31f288fefd783e5a2b43bde80a3b38b8e71" basis direct;
  }
  uncertainty { item unknown "These are administrative, regulatory and stakeholder-coordination mechanisms. Participant personnel, expertise and infrastructure are not resources owned or directly controlled by the AI Office."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id eu_ai_office; fact_type operational_capacity; operational_capacity { status active; capacity_type partnership_network; capacity_components { commission_department_collaboration, union_body_cooperation, member_state_authority_cooperation, dedicated_expert_and_stakeholder_platforms, scientific_experts_and_ai_developers }; evidence_refs { ec.european_ai_office.cooperation_platforms, eu.commission_decision_c_2024_1459.article_2_3 }; } }
}
