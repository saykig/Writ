record european_commission_union_law_mandate : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European Commission Union-law mandate";
  subjects { subject european_commission type institution role "responsible institution"; };
  assertion assigns "The Treaties assign the European Commission responsibility to ensure the application of the Treaties and measures adopted under them and to oversee the application of Union law.";
  topics { union_law }; scope { jurisdictions { "European Union" }; institutional_scope { european_commission }; temporal_scope {} conditions { "Treaty on European Union, Article 17(1)" }; }
  evidence { support eu.teu_article_17 document_version eu.teu_article_17.v2026_08_05 passage eu.teu_article_17.paragraph_1 locator "Treaty on European Union, Article 17(1)" quote "The Commission shall promote the general interest of the Union and take appropriate initiatives to that end. It shall ensure the application of the Treaties, and of measures adopted by the institutions pursuant to them. It shall oversee the application of Union law under the control of the Court of Justice of the European Union." passage_hash "sha256:531c238ed5486957122bc46cacc48cd9c1ddb55ba2977b4468b8135bff6d4bd6" document_hash "sha256:ee9da1327b780b2b4290b866dedceccad86793d468b36bbcc0fac594e93d2c08" basis direct; }
  uncertainty { item unknown "This establishes the Commission’s general treaty mandate concerning Union law. It does not by itself establish a particular enforcement procedure, sanction or power to refer a Member State to the Court of Justice."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id european_commission; fact_type mandate; mandate { status established; text "Ensure application of the Treaties and measures adopted under them and oversee application of Union law."; authority_source_ids { eu.teu_article_17 }; evidence_refs { eu.teu_article_17.paragraph_1 }; } }
}

record eu_ai_office_gp_ai_enforcement_mandate : institutional {
  corpus eu.institutions.european_commission; version "0.2.0"; title "European AI Office GPAI-enforcement mandate";
  subjects { subject eu_ai_office type organizational_unit role "implementing office"; };
  assertion assigns "Union law assigns the European AI Office responsibility for implementing the Commission’s supervision and enforcement tasks concerning providers of general-purpose AI models under Chapter V of the AI Act.";
  topics { artificial_intelligence }; scope { jurisdictions { "European Union" }; institutional_scope { eu_ai_office, european_commission }; temporal_scope {} conditions { "AI Act Chapter V supervision and enforcement" }; }
  evidence { support eu_ai_act_2024_1689 document_version dv_eu_ai_act_2024_1689 passage passage_eu_ai_act_art_88_1 locator "Regulation (EU) 2024/1689, Article 88(1)" quote "The Commission shall have exclusive powers to supervise and enforce Chapter V, taking into account the procedural guarantees under Article 94. The Commission shall entrust the implementation of these tasks to the AI Office, without prejudice to the powers of organisation of the Commission and the division of competences between Member States and the Union based on the Treaties." passage_hash "sha256:2dd98837f63e348517aad1b7413956d8b856601152817fa3cc711917cf955989" document_hash "sha256:903240828eef48f5d9ae9724aa365b6946d58fb9fb70143506292b3112c4248c" basis direct; }
  uncertainty { item unknown "The mandate concerns implementation of the Commission’s supervision and enforcement tasks. It does not transfer the Commission’s exclusive legal powers to the AI Office or establish every specific decision the Office may make."; }
  provenance { created_by "OpenAI Codex automated proposal"; created_at 2026-08-05; } review_state approved;
  institutional { institution_id eu_ai_office; fact_type mandate; mandate { status established; text "Implement the Commission’s supervision and enforcement tasks concerning providers of general-purpose AI models under AI Act Chapter V."; authority_source_ids { eu_ai_act_2024_1689, eu.commission_decision_c_2024_1459 }; evidence_refs { passage_eu_ai_act_art_88_1 }; } }
}

