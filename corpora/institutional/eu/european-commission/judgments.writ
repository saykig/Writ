language writ "0.2"
package eu.institutions.european_commission.judgments version "0.2.0";

// Human acceptance of all active Stage B records and the Core link. The automated
// proposal phase remains recorded in the review queue and authoritative human-review artifact.

judgment judgment_eu_ai_office_technical_documentation_receipt_review { target record eu_ai_office_tech_doc_receipt; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the directly assigned receipt function; receiving requested documentation is not a mandate, decision right or operational-capacity finding."; evidence_refs { passage_eu_01 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_training_sum_temp_function_review { target record eu_ai_office_training_sum_temp_function; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the directly assigned template-provision function; the assignment does not by itself establish mandate, enforcement power or operational capacity."; evidence_refs { passage_eu_04 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_serious_incident_report_receipt_review { target record eu_ai_office_serious_incident_report_receipt; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the directly assigned report-receipt function; receiving reports is not an adjudicative right or proof of operational capacity."; evidence_refs { passage_eu_08 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }

judgment judgment_european_commission_identity_review { target record european_commission_identity; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the treaty-supported identity as a supranational institution. Identity is not mission, mandate, function, authority or capacity."; evidence_refs { eu.teu_article_13.commission }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_identity_review { target record eu_ai_office_identity; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the Office’s identity as an organizational unit. Existence does not establish placement, mandate, functions, rights or capacity."; evidence_refs { eu.commission_decision_c_2024_1459.article_1 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_placement_review { target record eu_ai_office_placement; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping DG CONNECT as the direct parent named by the selected passage. The Commission remains the root institution in scope; placement is not legal personality, independence, mandate or authority."; evidence_refs { eu.commission_decision_c_2024_1459.article_1 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_mission_review { target record european_commission_mission; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the source-reported institutional purpose as mission while preserving that the source labels it a role. Mission does not replace treaty mandate or functions."; evidence_refs { eu.european_commission_institution.role }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_mission_review { target record eu_ai_office_mission; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the Office’s source-reported mission. Mission does not independently establish legal mandate, rights, enforcement powers or capacity."; evidence_refs { ec.european_ai_office.mission }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_union_law_mandate_review { target record european_commission_union_law_mandate; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the general treaty mandate concerning Union law. The mandate does not itself establish a particular procedure, sanction or CJEU referral right."; evidence_refs { eu.teu_article_17.paragraph_1 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_gp_ai_enforcement_mandate_review { target record eu_ai_office_gp_ai_enforcement_mandate; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the Office’s implementation responsibility for Chapter V tasks. The mandate does not transfer the Commission’s exclusive legal powers or imply every specific decision right."; evidence_refs { passage_eu_ai_act_art_88_1 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_legislative_proposal_function_review { target record european_commission_legislative_proposal_function; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the law-proposal activity as a function. It does not establish adoption of legislation, the full treaty mandate or unilateral legislative power."; evidence_refs { ec.planning_proposing_law.right_of_initiative }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_budget_mgmt_function_review { target record european_commission_budget_mgmt_function; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the budget-management activities as a function. The function is not a right over every budgetary act or proof of service-level resources."; evidence_refs { ec.budget_funding.commission_role }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_model_eval_function_review { target record eu_ai_office_model_eval_function; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping development of evaluation tools and benchmarks as a function. An assigned function is not a decision right, operational-capacity finding or performance result."; evidence_refs { eu.commission_decision_c_2024_1459.article_3_1_a }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_reasoned_op_function_review { target record european_commission_reasoned_op_function; type review_disposition; value "approved"; rationale "Human review approves the automated proposal classifying delivery of the reasoned opinion as a function because Article 258 says the Commission shall deliver it once the stated procedural conditions hold. This preserves mandatory modality and remains distinct from the discretionary CJEU-referral right."; evidence_refs { eu.tfeu_article_258.reasoned_opinion }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_cjeu_refer_decision_right_review { target record european_commission_cjeu_refer_decision_right; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the conditional CJEU-referral power. Referral does not determine the case outcome or confer a general adjudicative power."; evidence_refs { eu.tfeu_article_258.cjeu_referral }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_gp_ai_fine_decision_right_review { target record european_commission_gp_ai_fine_decision_right; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the Article 101 fine power only for specified GPAI-provider infringements and subject to the provision’s procedures and maximum amounts."; evidence_refs { passage_eu_ai_act_art_101_1 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_model_eval_decision_right_review { target record eu_ai_office_model_eval_decision_right; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the scoped power to conduct evaluations after Board consultation. It does not imply model-access, binding-measure or fine powers."; evidence_refs { passage_eu_ai_act_art_92_1 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_european_commission_jrc_infra_capacity_review { target record european_commission_jrc_infra_capacity; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the maintained JRC infrastructure network as capacity. The infrastructure count does not establish equal staffing, funding, utilization, condition or performance."; evidence_refs { ec.jrc_research_infrastructures.inventory }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_org_capacity_review { target record eu_ai_office_org_capacity; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping only the quoted staff threshold, six generic units and two generic advisers as organizational capacity; uncited unit and adviser names are omitted. It does not establish that every task is fully resourced."; evidence_refs { ec.european_ai_office.structure }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
judgment judgment_eu_ai_office_cooperation_capacity_review { target record eu_ai_office_cooperation_capacity; type review_disposition; value "approved"; rationale "Human review approves the automated proposal mapping only directly quoted cooperation with Commission services, Union bodies, Member State authorities, scientific experts, AI developers and stakeholders. An international-cooperation component is omitted as unsupported. External resources remain external."; evidence_refs { ec.european_ai_office.cooperation_platforms, eu.commission_decision_c_2024_1459.article_2_3 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }

judgment judgment_eu_ai_office_european_commission_relationship_review { target record_link eu_ai_office_european_commission_relationship; type record_link_disposition; value "approved"; rationale "Human review approves the automated proposal mapping the AI-Office-to-Commission root link as inherited through the directly evidenced DG CONNECT placement. The stored direction has no inverse duplicate and does not imply independent legal personality, mandate or control over every activity."; evidence_refs { eu.commission_decision_c_2024_1459.article_1 }; reviewer "Sara Kim"; status accepted; created_at 2026-08-08; family_context institutional; }
