language writ "0.1"
package test.weighted_ordinal version "1.0.0";

// Writ-owned synthetic fixture for generic weighted-ordinal behavior.
commitment SYNTHETIC_INSTITUTIONAL_CAPACITY {
  title "Synthetic institutional capacity";
  subjects { "synthetic-institution" };
  evaluation_window [2025-01-01, 2026-01-01];
  evidence_policy open_world;
  unknown_policy propagate;
  action_identity strict_separate by id;

  measure institutional_capacity {
    component administrative_reach weight 0.5 {
      anchor 0 when exists(claims where subject_ref == "administrative-reach" and object == 0);
      anchor 1 when exists(claims where subject_ref == "administrative-reach" and object == 1);
      anchor 2 when exists(claims where subject_ref == "administrative-reach" and object == 2);
      anchor 3 when exists(claims where subject_ref == "administrative-reach" and object == 3);
      anchor 4 when exists(claims where subject_ref == "administrative-reach" and object == 4);
    }
    component implementation_readiness weight 0.5 {
      anchor 0 when exists(claims where subject_ref == "implementation-readiness" and object == 0);
      anchor 1 when exists(claims where subject_ref == "implementation-readiness" and object == 1);
      anchor 2 when exists(claims where subject_ref == "implementation-readiness" and object == 2);
      anchor 3 when exists(claims where subject_ref == "implementation-readiness" and object == 3);
      anchor 4 when exists(claims where subject_ref == "implementation-readiness" and object == 4);
    }
    aggregate weighted_ordinal_percent scale 4;
  }

  score {
    result "not_applicable" priority 0 when institutional_capacity__public id measurement;
    otherwise not_applicable "This synthetic outcome is a graded measure.";
  }
}
