{
  "name": "@writ/analyzer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enumerate": {
      "types": "./dist/enumerate.d.ts",
      "import": "./dist/enumerate.js"
    },
    "./measure-analysis": {
      "types": "./dist/measure-analysis.d.ts",
      "import": "./dist/measure-analysis.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "dependencies": {
    "@writ/domain": "workspace:*",
    "z3-solver": "^5.0.0"
  }
}
