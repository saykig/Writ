{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/extensions/institutional-record.schema.json",
  "title": "Writ Atomic Institutional Record",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/recordBase"
    },
    {
      "type": "object",
      "required": ["institution_id", "institutional_fact_type"],
      "properties": {
        "family": { "const": "institutional" },
        "institution_id": {
          "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
        },
        "institutional_fact_type": { "$ref": "#/$defs/factType" },
        "institution_type": { "$ref": "#/$defs/institutionType" },
        "parent_institution_id": {
          "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/nonEmptyString"
        },
        "record_link": {
          "$ref": "https://writ.example/schemas/core/record-link.schema.json#/$defs/linkPayload"
        },
        "mission": { "$ref": "#/$defs/mission" },
        "mandate": { "$ref": "#/$defs/mandate" },
        "function": {
          "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/identifier"
        },
        "decision_right": { "$ref": "#/$defs/decisionRight" },
        "operational_capacity": { "$ref": "#/$defs/operationalCapacity" }
      },
      "oneOf": [
        {
          "properties": { "institutional_fact_type": { "const": "identity" } },
          "required": ["institution_type"],
          "not": { "$ref": "#/$defs/nonIdentityPayload" }
        },
        {
          "properties": { "institutional_fact_type": { "const": "placement" } },
          "required": ["parent_institution_id"],
          "not": { "$ref": "#/$defs/nonPlacementPayload" }
        },
        {
          "properties": { "institutional_fact_type": { "const": "relationship" } },
          "required": ["record_link"],
          "not": { "$ref": "#/$defs/nonRelationshipPayload" }
        },
        {
          "properties": { "institutional_fact_type": { "const": "mission" } },
          "required": ["mission"],
          "not": { "$ref": "#/$defs/nonMissionPayload" }
        },
        {
          "properties": { "institutional_fact_type": { "const": "mandate" } },
          "required": ["mandate"],
          "not": { "$ref": "#/$defs/nonMandatePayload" }
        },
        {
          "properties": { "institutional_fact_type": { "const": "function" } },
          "required": ["function"],
          "not": { "$ref": "#/$defs/nonFunctionPayload" }
        },
        {
          "properties": { "institutional_fact_type": { "const": "decision_right" } },
          "required": ["decision_right"],
          "not": { "$ref": "#/$defs/nonDecisionRightPayload" }
        },
        {
          "properties": { "institutional_fact_type": { "const": "operational_capacity" } },
          "required": ["operational_capacity"],
          "not": { "$ref": "#/$defs/nonCapacityPayload" }
        }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "factType": {
      "enum": [
        "identity",
        "placement",
        "relationship",
        "mission",
        "mandate",
        "function",
        "decision_right",
        "operational_capacity"
      ]
    },
    "institutionType": {
      "enum": [
        "government_department",
        "federal_agency",
        "independent_agency",
        "advisory_body",
        "regulator",
        "standards_body",
        "research_body",
        "interagency_body",
        "organizational_unit",
        "supranational_institution",
        "other",
        "unknown"
      ]
    },
    "mandateStatus": { "enum": ["established", "unknown", "contested"] },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/mandateStatus" },
        "text": { "type": "string", "minLength": 1 },
        "authority_source_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "decisionRight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/mandateStatus" },
        "text": { "type": "string", "minLength": 1 },
        "authority_source_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "operationalCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "capacity_type", "evidence_refs"],
      "properties": {
        "status": {
          "enum": ["active", "planned", "limited", "degraded", "suspended", "retired", "unknown"]
        },
        "capacity_type": {
          "enum": [
            "organizational_unit",
            "laboratory_network",
            "facility",
            "program",
            "technical_capability",
            "accreditation_system",
            "partnership_network",
            "other"
          ]
        },
        "capacity_components": {
          "type": "array",
          "items": {
            "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "as_of_date": { "type": "string", "format": "date" },
        "quantity": { "$ref": "#/$defs/capacityQuantity" },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "dependentRequired": { "quantity": ["as_of_date"] }
    },
    "capacityQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "qualifier"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": {
          "$ref": "https://writ.example/schemas/core/record.schema.json#/$defs/identifier"
        },
        "qualifier": { "enum": ["exact", "approximate", "minimum", "maximum"] }
      }
    },
    "nonIdentityPayload": {
      "anyOf": [
        { "required": ["parent_institution_id"] },
        { "required": ["record_link"] },
        { "required": ["mission"] },
        { "required": ["mandate"] },
        { "required": ["function"] },
        { "required": ["decision_right"] },
        { "required": ["operational_capacity"] }
      ]
    },
    "nonPlacementPayload": {
      "anyOf": [
        { "required": ["institution_type"] },
        { "required": ["record_link"] },
        { "required": ["mission"] },
        { "required": ["mandate"] },
        { "required": ["function"] },
        { "required": ["decision_right"] },
        { "required": ["operational_capacity"] }
      ]
    },
    "nonRelationshipPayload": {
      "anyOf": [
        { "required": ["institution_type"] },
        { "required": ["parent_institution_id"] },
        { "required": ["mission"] },
        { "required": ["mandate"] },
        { "required": ["function"] },
        { "required": ["decision_right"] },
        { "required": ["operational_capacity"] }
      ]
    },
    "nonMissionPayload": {
      "anyOf": [
        { "required": ["institution_type"] },
        { "required": ["parent_institution_id"] },
        { "required": ["record_link"] },
        { "required": ["mandate"] },
        { "required": ["function"] },
        { "required": ["decision_right"] },
        { "required": ["operational_capacity"] }
      ]
    },
    "nonMandatePayload": {
      "anyOf": [
        { "required": ["institution_type"] },
        { "required": ["parent_institution_id"] },
        { "required": ["record_link"] },
        { "required": ["mission"] },
        { "required": ["function"] },
        { "required": ["decision_right"] },
        { "required": ["operational_capacity"] }
      ]
    },
    "nonFunctionPayload": {
      "anyOf": [
        { "required": ["institution_type"] },
        { "required": ["parent_institution_id"] },
        { "required": ["record_link"] },
        { "required": ["mission"] },
        { "required": ["mandate"] },
        { "required": ["decision_right"] },
        { "required": ["operational_capacity"] }
      ]
    },
    "nonDecisionRightPayload": {
      "anyOf": [
        { "required": ["institution_type"] },
        { "required": ["parent_institution_id"] },
        { "required": ["record_link"] },
        { "required": ["mission"] },
        { "required": ["mandate"] },
        { "required": ["function"] },
        { "required": ["operational_capacity"] }
      ]
    },
    "nonCapacityPayload": {
      "anyOf": [
        { "required": ["institution_type"] },
        { "required": ["parent_institution_id"] },
        { "required": ["record_link"] },
        { "required": ["mission"] },
        { "required": ["mandate"] },
        { "required": ["function"] },
        { "required": ["decision_right"] }
      ]
    }
  }
}
