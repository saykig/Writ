{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant.example/schemas/search-protocol.schema.json",
  "title": "Covenant Negative Evidence Search Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "commitment_id",
    "subject_id",
    "evaluation_window",
    "cutoff",
    "source_registry_ids",
    "queries",
    "languages",
    "coverage_assessment",
    "result",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string"
    },
    "commitment_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "evaluation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "source_registry_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "executed_at",
          "source_registry_id",
          "result_count"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_registry_id": {
            "type": "string"
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "cursor_or_page_range": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "coverage_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "known_gaps",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "sufficient",
            "insufficient",
            "contested"
          ]
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "result": {
      "enum": [
        "no_qualifying_action_found",
        "qualifying_action_found",
        "inconclusive"
      ]
    },
    "candidate_action_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_claim_id": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "decision",
        "rationale",
        "reviewed_at"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "contest",
            "request_changes"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
