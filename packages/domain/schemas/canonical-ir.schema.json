{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.example/schemas/analysis/canonical-ir.schema.json",
  "title": "Writ Canonical Intermediate Representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language_version",
    "package",
    "commitments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "language_version": {
      "type": "string"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeDecl"
      }
    },
    "commitments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/commitment"
      }
    },
    "source_map": {
      "type": "object"
    },
    "diagnostic_waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "content_hash",
        "imports"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "content_hash"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "content_hash": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "typeDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "enum",
            "concept",
            "entity",
            "alias"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "start_inclusive",
        "end_inclusive"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "start_inclusive": {
          "type": "boolean"
        },
        "end_inclusive": {
          "type": "boolean"
        }
      }
    },
    "namedElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "default"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string"
        },
        "default": {},
        "allowed": {
          "type": "array"
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "key_paths"
      ],
      "properties": {
        "policy": {
          "enum": [
            "review_required",
            "strict_deduplicate",
            "strict_separate",
            "propagate_uncertainty"
          ]
        },
        "key_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "subjects",
        "evaluation_window",
        "evidence_policy",
        "unknown_policy",
        "parameters",
        "action_identity",
        "predicates",
        "classifications",
        "variables",
        "score_program",
        "assertions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string"
        },
        "summit_id": {
          "type": "string"
        },
        "authority_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adopted_at": {
          "type": "string",
          "format": "date"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evaluation_window": {
          "$ref": "#/$defs/interval"
        },
        "issue_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_policy": {
          "enum": [
            "open_world",
            "closed_world"
          ]
        },
        "unknown_policy": {
          "enum": [
            "propagate",
            "explicit_rules_only",
            "treat_false",
            "treat_true"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedElement"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedElement"
          }
        },
        "partner_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedElement"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "action_identity": {
          "$ref": "#/$defs/actionIdentity"
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "classifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classificationBlock"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "score_program": {
          "$ref": "#/$defs/scoreProgram"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "rationales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rationale"
          }
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parameters",
        "rules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deriveRule"
          }
        }
      }
    },
    "deriveRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conclusion",
        "when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "conclusion": {
          "enum": [
            "true",
            "false",
            "unknown",
            "contested"
          ]
        },
        "when": {
          "$ref": "#/$defs/expr"
        },
        "priority": {
          "type": "integer"
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_id": {
          "type": "string"
        }
      }
    },
    "classificationBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "rules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "mode": {
          "enum": [
            "exclusive",
            "multi_label"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classificationRule"
          }
        },
        "otherwise_label": {
          "type": "string"
        },
        "otherwise_safe_under_open_world": {
          "type": "boolean"
        }
      }
    },
    "classificationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "priority",
        "when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "when": {
          "$ref": "#/$defs/expr"
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_id": {
          "type": "string"
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "expression"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string"
        },
        "expression": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "scoreProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "otherwise"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scoreRule"
          }
        },
        "otherwise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "message"
          ],
          "properties": {
            "result": {
              "enum": [
                "unresolved",
                "not_applicable",
                "-1",
                "0",
                "+1"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "scoreRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "result",
        "when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "priority": {
          "type": "integer"
        },
        "result": {
          "enum": [
            "-1",
            "0",
            "+1",
            "not_applicable"
          ]
        },
        "when": {
          "$ref": "#/$defs/expr"
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_id": {
          "type": "string"
        },
        "intentional_overlap": {
          "type": "boolean"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "exhaustive",
            "non_overlapping",
            "monotonic",
            "no_unanchored_claims",
            "all_score_inputs_reviewed",
            "custom"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain"
          }
        },
        "expression": {
          "$ref": "#/$defs/expr"
        },
        "exceptions": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "values"
      ],
      "properties": {
        "variable": {
          "type": "string"
        },
        "values": {
          "oneOf": [
            {
              "type": "array"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "integer"
                },
                "max": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "type": "string"
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_code",
        "object_id",
        "rationale",
        "approved_by"
      ],
      "properties": {
        "diagnostic_code": {
          "type": "string"
        },
        "object_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "expr": {
      "oneOf": [
        {
          "$ref": "#/$defs/literalExpr"
        },
        {
          "$ref": "#/$defs/refExpr"
        },
        {
          "$ref": "#/$defs/unaryExpr"
        },
        {
          "$ref": "#/$defs/naryExpr"
        },
        {
          "$ref": "#/$defs/compareExpr"
        },
        {
          "$ref": "#/$defs/callExpr"
        },
        {
          "$ref": "#/$defs/queryExpr"
        }
      ]
    },
    "literalExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {}
      }
    },
    "refExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "ref"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "unaryExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "operand"
      ],
      "properties": {
        "kind": {
          "const": "unary"
        },
        "op": {
          "enum": [
            "not",
            "is_known",
            "is_contested",
            "nonempty"
          ]
        },
        "operand": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "naryExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "operands"
      ],
      "properties": {
        "kind": {
          "const": "nary"
        },
        "op": {
          "enum": [
            "and",
            "or",
            "set",
            "add",
            "multiply"
          ]
        },
        "operands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    },
    "compareExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "compare"
        },
        "op": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "between",
            "overlaps",
            "before",
            "after",
            "contains"
          ]
        },
        "left": {
          "$ref": "#/$defs/expr"
        },
        "right": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "callExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "function",
        "arguments"
      ],
      "properties": {
        "kind": {
          "const": "call"
        },
        "function": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    },
    "queryExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "collection"
      ],
      "properties": {
        "kind": {
          "const": "query"
        },
        "operation": {
          "enum": [
            "count",
            "count_distinct",
            "exists",
            "forall",
            "sum",
            "ratio",
            "coverage",
            "min",
            "max"
          ]
        },
        "collection": {
          "type": "string"
        },
        "where": {
          "$ref": "#/$defs/expr"
        },
        "distinct_by": {
          "type": "string"
        },
        "select": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "anchorRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "when"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "when": {
          "$ref": "#/$defs/expr"
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_id": {
          "type": "string"
        }
      }
    },
    "measureComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "anchors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anchorRule"
          }
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_id": {
          "type": "string"
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "components",
        "aggregation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measureComponent"
          }
        },
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "scale"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "weighted_ordinal_percent"
              ]
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "source_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_id": {
          "type": "string"
        }
      }
    }
  }
}
