{
  "name": "@writ/provenance",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test && npm run test:packed",
    "test:packed": "npm run build && node test/packed-consumer.mjs",
    "prepack": "npm run build",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
